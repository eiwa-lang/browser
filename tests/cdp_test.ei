import { assert } from "std.core"
import { parseJson } from "std.json"
import { cdpRequest, cdpRequestSession, createTargetCmd, attachCmd, navigateCmd, evaluateCmd, closeTargetCmd, historyEntryCmd, parseHistoryEntry, locatorTextScript, locatorClickScript, locatorFillScript, locatorTypeScript, locatorAttrScript, locatorWaitScript, locatorFocusScript, inputInsertCmd, inputKeyCmd, vkFor, storageCookiesCmd, storageSetCmd, storageClearCmd, parseStorageCookies, parseAttached, parseTargetCreated, parseNavigateFrame, evaluateValue, cdpEventMethod, cdpSessionOf } from ".browser.chromium.cdp_commands"
import { Cookie } from ".browser.storage.cookies"
import { parseWsUrl } from ".browser.chromium.cdp"

test "cdp: endpoint parsing covers real Chromium shapes" {
    val noPort = parseWsUrl("ws://127.0.0.1/devtools/browser/abc", 9333)!!
    assert(noPort.host == "127.0.0.1")
    assert(noPort.port == 9333)
    assert(noPort.path == "/devtools/browser/abc")
    val withPort = parseWsUrl("ws://127.0.0.1:9333/devtools/browser/abc", 80)!!
    assert(withPort.port == 9333)
    assert(parseWsUrl("http://127.0.0.1:9333/x", 80) == null)
    assert(parseWsUrl("ws://127.0.0.1:/x", 80) == null)
    assert(parseWsUrl("ws:///x", 80) == null)
    assert(parseWsUrl("ws://127.0.0.1", 80) == null)
}

test "cdp: target lifecycle commands" {
    val create = parseJson(createTargetCmd(1, "https://example.com")!!)
    assert(create.get("method")!!.asString() == "Target.createTarget")
    assert(create.get("params")!!.get("url")!!.asString() == "https://example.com")
    assert(createTargetCmd(1, "") == null)
    val target = parseTargetCreated(parseJson("{\"id\": 1, \"result\": {\"targetId\": \"T1\"}}"))!!
    assert(target == "T1")
    assert(parseTargetCreated(parseJson("{\"id\": 1, \"error\": {}}")) == null)
    val attach = parseJson(attachCmd(2, "T1")!!)
    assert(attach.get("params")!!.get("flatten")!!.asBool())
    assert(attachCmd(2, "") == null)
    val session = parseAttached(parseJson("{\"id\": 2, \"result\": {\"sessionId\": \"S1\"}}"))!!
    assert(session.session == "S1")
    assert(parseAttached(parseJson("{\"id\": 2, \"result\": {}}")) == null)
    assert(closeTargetCmd(9, "T1") != null)
    assert(closeTargetCmd(9, "") == null)
}

test "cdp: session commands carry sessionId" {
    val nav = parseJson(navigateCmd(3, "S1", "https://example.com")!!)
    assert(nav.get("sessionId")!!.asString() == "S1")
    assert(nav.get("method")!!.asString() == "Page.navigate")
    assert(navigateCmd(3, "", "https://example.com") == null)
    assert(navigateCmd(3, "S1", "") == null)
    val frame = parseNavigateFrame(parseJson("{\"id\": 3, \"result\": {\"frameId\": \"F1\", \"loaderId\": \"L1\"}}"))!!
    assert(frame == "F1")
    val ev = parseJson(evaluateCmd(4, "S1", "() => 1")!!)
    assert(ev.get("method")!!.asString() == "Runtime.evaluate")
    assert(evaluateCmd(4, "S1", "") == null)
    val plain = cdpRequest(5, "Target.getTargets", "{}")
    assert(parseJson(plain).get("id")!!.asNumber().toInt() == 5)
    val sess = cdpRequestSession(6, "S1", "Page.enable", "{}")
    assert(parseJson(sess).get("sessionId")!!.asString() == "S1")
}

test "cdp: evaluate values and load events" {
    val value = evaluateValue(parseJson("{\"id\": 4, \"result\": {\"result\": {\"type\": \"string\", \"value\": \"hi\"}}}"))!!
    assert(value.asString() == "hi")
    assert(evaluateValue(parseJson("{\"id\": 4, \"result\": {\"result\": {\"type\": \"undefined\"}}}")) == null)
    assert(evaluateValue(parseJson("{\"id\": 4, \"result\": {\"result\": {}, \"exceptionDetails\": {\"text\": \"x\"}}}")) == null)
    val load = parseJson("{\"method\": \"Page.loadEventFired\", \"params\": {\"timestamp\": 1.5}, \"sessionId\": \"S1\"}")
    assert(cdpEventMethod(load) == "Page.loadEventFired")
    assert(cdpSessionOf(load) == "S1")
    assert(cdpEventMethod(parseJson("{\"id\": 1}")) == "")
    assert(cdpSessionOf(parseJson("{\"id\": 1}")) == "")
}

test "cdp: history travel commands" {
    assert(historyEntryCmd(7, "", 3) == null)
    assert(historyEntryCmd(7, "S1", 0) == null)
    val back = parseJson(historyEntryCmd(7, "S1", 12)!!)
    assert(back.get("method")!!.asString() == "Page.navigateToHistoryEntry")
    assert(back.get("params")!!.get("entryId")!!.asNumber().toInt() == 12)
    assert(back.get("sessionId")!!.asString() == "S1")
    val history = parseJson("{\"id\": 8, \"result\": {\"currentIndex\": 1, \"entries\": [{\"id\": 101, \"url\": \"https://a.example\"}, {\"id\": 102, \"url\": \"https://b.example\"}, {\"id\": 103, \"url\": \"https://c.example\"}]}}")
    assert(parseHistoryEntry(history, -1) == 101)
    assert(parseHistoryEntry(history, 1) == 103)
    assert(parseHistoryEntry(history, 5) == null)
    assert(parseHistoryEntry(history, -5) == null)
    assert(parseHistoryEntry(parseJson("{\"id\": 8, \"result\": {}}"), 1) == null)
}

test "cdp: locator text script" {
    assert(locatorTextScript("", "h1") == null)
    assert(locatorTextScript("css", "") == null)
    val script = locatorTextScript("css", "h1")!!
    assert(script.indexOf("\"strategy\":\"css\"") >= 0)
    assert(script.indexOf("\"selector\":\"h1\"") >= 0)
    assert(script.indexOf("querySelector") >= 0)
    val quoted = locatorTextScript("text", "it's")!!
    assert(quoted.indexOf("it's") >= 0)
}

test "cdp: locator action scripts" {
    assert(locatorClickScript("", "h1") == null)
    assert(locatorClickScript("css", "") == null)
    val click = locatorClickScript("css", "h1")!!
    assert(click.indexOf("\"strategy\":\"css\"") >= 0)
    assert(click.indexOf("el.click()") >= 0)
    val fill = locatorFillScript("css", "q", "say \"hi\"")!!
    assert(fill.indexOf("\\\"hi\\\"") >= 0)
    assert(fill.indexOf("el.value") >= 0)
    assert(locatorFillScript("css", "q", "") != null)
    val tp = locatorTypeScript("xpath", "//i", "a")!!
    assert(tp.indexOf("el.value") >= 0)
    val attr = locatorAttrScript("css", "a", "href")!!
    assert(attr.indexOf("getAttribute") >= 0)
    assert(locatorAttrScript("css", "a", "") == null)
}

test "cdp: locator wait script" {
    assert(locatorWaitScript("", "h1") == null)
    assert(locatorWaitScript("css", "") == null)
    val script = locatorWaitScript("css", "h1")!!
    assert(script.indexOf("\"strategy\":\"css\"") >= 0)
    assert(script.indexOf("getBoundingClientRect") >= 0)
}

test "cdp: input commands" {
    assert(locatorFocusScript("", "h1") == null)
    val focus = locatorFocusScript("css", "h1")!!
    assert(focus.indexOf("el.focus()") >= 0)
    assert(locatorFocusScript("", "h1") == null)
    val focus = locatorFocusScript("css", "h1")!!
    assert(focus.indexOf("el.focus()") >= 0)
    assert(inputInsertCmd(3, "", "a") == null)
    val ins = parseJson(inputInsertCmd(3, "S1", "a")!!)
    assert(ins.get("method")!!.asString() == "Input.insertText")
    assert(inputKeyCmd(4, "S1", "keyDown", "Enter", "Enter", 13) != null)
    assert(inputKeyCmd(4, "", "keyDown", "Enter", "Enter", 13) == null)
    val key = parseJson(inputKeyCmd(4, "S1", "keyDown", "Enter", "Enter", 13)!!)
    assert(key.get("params")!!.get("windowsVirtualKeyCode")!!.asNumber().toInt() == 13)
    assert(vkFor("Enter") == 13)
    assert(vkFor("ArrowLeft") == 37)
    assert(vkFor("F99") == 0)
    assert(vkFor("") == 0)
}

test "cdp: storage cookie commands" {
    assert(storageCookiesCmd(1, "") == null)
    val get = parseJson(storageCookiesCmd(1, "CB1")!!)
    assert(get.get("method")!!.asString() == "Storage.getCookies")
    val set = parseJson(storageSetCmd(2, "CB1", Cookie("sid", "abc", "shop.example.com"))!!)
    assert(set.get("params")!!.get("cookies") != null)
    assert(storageSetCmd(2, "CB1", Cookie("sid", "abc")) == null)
    assert(storageClearCmd(3, "") == null)
    assert(storageClearCmd(3, "CB1") != null)
    val jar = parseJson("{\"id\": 1, \"result\": {\"cookies\": [{\"name\": \"sid\", \"value\": \"abc\", \"domain\": \"shop.example.com\"}, {\"value\": \"noname\"}]}}")
    val parsed = parseStorageCookies(jar)
    assert(parsed.size() == 1)
    assert(parsed.get(0).name == "sid")
    assert(parsed.get(0).value == "abc")
}
