import { assert } from "std.core"
import { parseJson, Json } from "std.json"
import { sleepMs } from "std.time"
import { TCPServer, Socket } from "std.net"
import { buildFrame, wsRecv, writeAll } from ".browser.net.ws"
import { readHttpRequest, answerHandshake } from ".browser.net.ws_server"
import { Chromium } from ".browser.chromium.chromium"
import { CdpConn, cdpConn } from ".browser.chromium.connection"
import { Engine } from ".browser.engine.engine"
import { WsClient, wsConnect } from ".browser.net.ws"

fun engineReply(id: Int, result: String): String {
    return "{\"id\": $id, \"result\": $result}"
}

fun engineSession(sock: Socket): String {
    var open = true
    while (open) {
        val f = wsRecv(sock)
        if (f == null) {
            return "closed"
        }
        if (f.opcode == 8) {
            return "ok"
        }
        if (f.opcode == 1) {
            val msg = parseJson(f.payload)
            val id = msg.get("id")
            if (id != null && id!!.isNumber()) {
                val num = id!!.asNumber().toInt()
                val method = msg.get("method")
                if (method != null && method!!.isString()) {
                    val name = method!!.asString()
                    if (name == "Target.createBrowserContext") {
                        writeAll(sock, buildFrame(1, engineReply(num, ["browserContextId" of "CB1"].toJson()), null))
                    } else if (name == "Target.disposeBrowserContext") {
                        writeAll(sock, buildFrame(1, engineReply(num, "{}"), null))
                    } else if (name == "Target.createTarget") {
                        writeAll(sock, buildFrame(1, engineReply(num, ["targetId" of "T1"].toJson()), null))
                    } else if (name == "Target.attachToTarget") {
                        writeAll(sock, buildFrame(1, engineReply(num, ["sessionId" of "S1"].toJson()), null))
                    } else if (name == "Target.closeTarget") {
                        writeAll(sock, buildFrame(1, engineReply(num, "{\"success\": true}"), null))
                    } else if (name == "Page.enable") {
                        writeAll(sock, buildFrame(1, engineReply(num, "{}"), null))
                    } else if (name == "Page.navigate") {
                        writeAll(sock, buildFrame(1, engineReply(num, ["frameId" of "F1"].toJson()), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Runtime.evaluate") {
                        val params = msg.get("params")
                        var script = ""
                        if (params != null) {
                            val expr = params!!.get("expression")
                            if (expr != null && expr!!.isString()) {
                                script = expr!!.asString()
                            }
                        }
                        if (script.indexOf("innerText") >= 0) {
                            writeAll(sock, buildFrame(1, engineReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"Fake heading\"}}"), null))
                        } else {
                            writeAll(sock, buildFrame(1, engineReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"<html>fake</html>\"}}"), null))
                        }
                    } else {
                        writeAll(sock, buildFrame(1, engineReply(num, "{}"), null))
                    }
                }
            }
        }
    }
    return "closed"
}

fun engineFake(port: Int): String {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return "bind-fail"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val head = readHttpRequest(conn)
    if (head == null) {
        server.close()
        return "read-fail"
    }
    if (answerHandshake(conn, head) == false) {
        server.close()
        return "handshake-fail"
    }
    val out = engineSession(conn)
    conn.close()
    server.close()
    return out
}

fun wsConnectRetry(port: Int, path: String): WsClient? {
    var tries = 0
    while (tries < 50) {
        val ws = wsConnect("127.0.0.1", port, path)
        if (ws != null) {
            return ws
        }
        sleepMs(100)
        tries = tries + 1
    }
    return null
}

fun engineClient(port: Int): String {
    val ws = wsConnectRetry(port, "/fake")
    if (ws == null) {
        return "no-conn"
    }
    val engine = Engine(Chromium("fake", 0, -1), cdpConn(ws))
    val ctx = engine.newContext()
    if (ctx == null) {
        ws.close()
        return "no-ctx"
    }
    val page = engine.newPage(ctx)
    if (page == null) {
        ws.close()
        return "no-page"
    }
    if (engine.goto(page, "https://example.com", 5000) == false) {
        ws.close()
        return "no-goto"
    }
    val text = engine.text(page)
    if (text == null || text != "Fake heading") {
        ws.close()
        return "no-text"
    }
    val html = engine.content(page)
    if (html == null || html != "<html>fake</html>") {
        ws.close()
        return "no-content"
    }
    if (engine.closePage(page) == false) {
        ws.close()
        return "no-closepage"
    }
    if (engine.closeContext(ctx) == false) {
        ws.close()
        return "no-closectx"
    }
    if (engine.goto(page, "https://example.com", 1000)) {
        ws.close()
        return "gone-page-ok"
    }
    ws.close()
    return "ok"
}

test "engine: full automation flow against a fake" {
    val port = 19895
    val server = task {
        engineFake(port)
    }
    sleepMs(150)
    val client = task {
        engineClient(port)
    }
    assert(client.await() == "ok")
    assert(server.await() == "ok")
}
