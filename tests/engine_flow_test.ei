import { assert } from "std.core"
import { parseJson } from "std.json"
import { sleepMs } from "std.time"
import { TCPServer, Socket } from "std.net"
import { List, MutableList } from "std.collections"
import { buildFrame, wsRecv, writeAll, wsConnect } from ".browser.net.ws"
import { readHttpRequest, answerHandshake } from ".browser.net.ws_server"
import { Chromium } from ".browser.chromium.chromium"
import { Cookie } from ".browser.storage.cookies"
import { cdpConn } from ".browser.chromium.connection"
import { Engine, systemTempDir } from ".browser.engine.engine"
import { File } from "std.fs"
import { Encoding } from "crypto.encoding"

fun stageReply(id: Int, result: String): String {
    return "{\"id\": $id, \"result\": $result}"
}

// Eventual delivery: pushed CDP events can stall behind delayed ACKs
// (tens of ms on Linux), so accumulate across bounded drains instead
// of asserting on a single synchronous one.
fun drainWant(engine: Engine, want: Int): List<String> {
    val out: MutableList<String> = MutableList<String>()
    var tries = 0
    while (tries < 30 && out.size() < want) {
        val notes = engine.drain()
        var i = 0
        while (i < notes.size()) {
            out.add(notes.get(i))
            i = i + 1
        }
        if (out.size() < want) {
            sleepMs(100)
        }
        tries = tries + 1
    }
    return out.freeze()
}

// Accumulate drains until some note contains the needle (fresh-event
// marker) or the budget runs out. A stale pre-resub event satisfies a
// bare count but never the fresh marker.
fun drainUntil(engine: Engine, needle: String): List<String> {
    val out: MutableList<String> = MutableList<String>()
    var tries = 0
    var found = false
    while (tries < 30 && found == false) {
        val notes = engine.drain()
        var i = 0
        while (i < notes.size()) {
            out.add(notes.get(i))
            if (notes.get(i).indexOf(needle) >= 0) {
                found = true
            }
            i = i + 1
        }
        if (found == false) {
            sleepMs(100)
        }
        tries = tries + 1
    }
    return out.freeze()
}

fun stageSession(sock: Socket): String {
    var open = true
    var waitPolls = 0
    var hrefPolls = 0
    var netOn = false
    var conCount = 0
    while (open) {
        val f = wsRecv(sock)
        if (f == null) {
            return "closed"
        }
        if (f.opcode == 8) {
            return "ok"
        }
        if (f.opcode == 1) {
            val msg = parseJson(f.payload)
            val id = msg.get("id")
            if (id != null && id!!.isNumber()) {
                val num = id!!.asNumber().toInt()
                val method = msg.get("method")
                if (method != null && method!!.isString()) {
                    val name = method!!.asString()
                    if (name == "Target.createBrowserContext") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{\"browserContextId\": \"CB1\"}"), null))
                    } else if (name == "Target.disposeBrowserContext") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                    } else if (name == "Target.createTarget") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{\"targetId\": \"T1\"}"), null))
                    } else if (name == "Target.attachToTarget") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{\"sessionId\": \"S1\"}"), null))
                    } else if (name == "Target.closeTarget") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                    } else if (name == "Page.enable") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                    } else if (name == "Page.navigate") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{\"frameId\": \"F1\"}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Page.reload") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Page.getNavigationHistory") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{\"currentIndex\": 1, \"entries\": [{\"id\": 101}, {\"id\": 102}, {\"id\": 103}]}"), null))
                    } else if (name == "Page.navigateToHistoryEntry") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Input.dispatchKeyEvent" || name == "Input.insertText") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                    } else if (name == "Network.enable" || name == "Runtime.enable") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                        if (name == "Network.enable" && netOn == false) {
                            netOn = true
                            writeAll(sock, buildFrame(1, "{\"method\": \"Network.requestWillBeSent\", \"params\": {\"requestId\": \"req-1\", \"request\": {\"url\": \"https://example.com\", \"method\": \"GET\"}}, \"sessionId\": \"S1\"}", null))
                            writeAll(sock, buildFrame(1, "{\"method\": \"Network.responseReceived\", \"params\": {\"requestId\": \"req-1\", \"response\": {\"url\": \"https://example.com\", \"status\": 200}}, \"sessionId\": \"S1\"}", null))
                        } else if (name == "Runtime.enable") {
                            conCount = conCount + 1
                            val mark = conCount
                            writeAll(sock, buildFrame(1, "{\"method\": \"Runtime.consoleAPICalled\", \"params\": {\"type\": \"log\", \"args\": [{\"type\": \"string\", \"value\": \"hello-$mark\"}]}, \"sessionId\": \"S1\"}", null))
                        }
                    } else if (name == "Browser.setDownloadBehavior") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Browser.downloadWillBegin\", \"params\": {\"frameId\": \"F1\", \"guid\": \"G7\", \"url\": \"https://example.com/f.pdf\", \"suggestedFilename\": \"f.pdf\"}}", null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Browser.downloadProgress\", \"params\": {\"guid\": \"G7\", \"totalBytes\": 8, \"receivedBytes\": 8, \"state\": \"completed\"}}", null))
                    } else if (name == "Storage.getCookies") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{\"cookies\": [{\"name\": \"sid\", \"value\": \"abc\", \"domain\": \"shop.example.com\", \"path\": \"/\", \"expires\": 0, \"httpOnly\": true, \"secure\": false, \"sameSite\": \"Lax\"}, {\"name\": \"x\", \"value\": \"1\"}]}"), null))
                    } else if (name == "Storage.setCookies" || name == "Storage.clearCookies") {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                    } else if (name == "Runtime.evaluate") {
                        if (f.payload.indexOf("el.focus") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"ok\"}}"), null))
                        } else if (f.payload.indexOf("getBoundingClientRect") >= 0) {
                            waitPolls = waitPolls + 1
                            if (waitPolls < 3) {
                                writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"object\", \"subtype\": \"null\"}}"), null))
                            } else {
                                writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"found\"}}"), null))
                            }
                        } else if (f.payload.indexOf("window.location.href") >= 0) {
                            hrefPolls = hrefPolls + 1
                            if (hrefPolls < 3) {
                                writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"https://x.example/other\"}}"), null))
                            } else {
                                writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"https://shop.example/result/1\"}}"), null))
                            }
                        } else if (f.payload.indexOf("el.click") >= 0 || f.payload.indexOf("el.value") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"ok\"}}"), null))
                        } else if (f.payload.indexOf("getAttribute") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"A\"}}"), null))
                        } else if (f.payload.indexOf("outerHTML") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"<h1>H</h1>\"}}"), null))
                        } else if (f.payload.indexOf("() => 42") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"number\", \"value\": 42}}"), null))
                        } else if (f.payload.indexOf("it's") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"quoted\"}}"), null))
                        } else if (f.payload.indexOf("strategy") >= 0) {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"scoped\"}}"), null))
                        } else {
                            writeAll(sock, buildFrame(1, stageReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"v\"}}"), null))
                        }
                    } else {
                        writeAll(sock, buildFrame(1, stageReply(num, "{}"), null))
                    }
                }
            }
        }
    }
    return "closed"
}

fun stageFake(port: Int): String {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return "bind-fail"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val head = readHttpRequest(conn)
    if (head == null) {
        server.close()
        return "read-fail"
    }
    if (answerHandshake(conn, head) == false) {
        server.close()
        return "handshake-fail"
    }
    val out = stageSession(conn)
    conn.close()
    server.close()
    return out
}

fun stageEngine(port: Int): Engine? {
    val ws = wsConnect("127.0.0.1", port, "/fake")
    if (ws == null) {
        return null
    }
    return Engine(Chromium("fake", 0, -1), cdpConn(ws))
}

fun driveStage(port: Int, stage: Int): String {
    val engine = stageEngine(port)
    if (engine == null) {
        return "no-engine"
    }
    val out = driveInner(engine, stage)
    engine.close()
    return out
}

fun driveInner(engine: Engine, stage: Int): String {
    val ctx = engine.newContext()
    if (ctx == null) {
        return "no-ctx"
    }
    if (stage == 1) {
        return "ok"
    }
    val page = engine.newPage(ctx)
    if (page == null) {
        return "no-page"
    }
    if (stage == 2) {
        return "ok"
    }
    if (engine.goto(page, "https://example.com", 5000) == false) {
        return "no-goto"
    }
    if (stage == 3) {
        return "ok"
    }
    val text = engine.text(page)
    if (text == null) {
        return "no-text"
    }
    if (stage == 4) {
        return "ok"
    }
    if (engine.reload(page, 5000) == false) {
        return "no-reload"
    }
    if (stage == 5) {
        return "ok"
    }
    if (engine.goBack(page, 5000) == false) {
        return "no-back"
    }
    if (stage == 6) {
        return "ok"
    }
    if (engine.goForward(page, 5000) == false) {
        return "no-forward"
    }
    if (stage == 7) {
        return "ok"
    }
    if (engine.textByLocator(page, "css", "h1") != "scoped") {
        return "no-scoped"
    }
    if (engine.textByLocator(page, "text", "it's") != "quoted") {
        return "no-quoted"
    }
    if (stage == 8) {
        return "ok"
    }
    if (engine.click(page, "css", "#go") == false) {
        return "no-click"
    }
    if (engine.fill(page, "css", "#q", "say \"hi\"") == false) {
        return "no-fill"
    }
    if (engine.typeText(page, "css", "#q", "!") == false) {
        return "no-type"
    }
    if (stage == 9) {
        return "ok"
    }
    if (engine.attribute(page, "css", "a", "href") != "A") {
        return "no-attr"
    }
    if (stage == 10) {
        return "ok"
    }
    if (engine.content(page) != "<h1>H</h1>") {
        return "no-content"
    }
    if (engine.evaluate(page, "() => 42") != "42") {
        return "no-eval"
    }
    if (stage == 11) {
        return "ok"
    }
    if (engine.waitFor(page, "css", ".product-detail", 5000) == false) {
        return "no-wait"
    }
    if (stage == 12) {
        return "ok"
    }
    if (engine.waitForUrl(page, "**/result/**", 5000) == false) {
        return "no-wait-url"
    }
    if (stage == 13) {
        return "ok"
    }
    if (engine.press(page, "css", "#q", "Enter") == false) {
        return "no-press"
    }
    if (stage == 14) {
        return "ok"
    }
    if (engine.press(page, "css", "#q", "a") == false) {
        return "no-press-char"
    }
    if (engine.press(page, "css", "#q", "F99")) {
        return "pressed-unknown"
    }
    if (stage == 15) {
        return "ok"
    }
    val jar = engine.cookies(ctx)
    if (jar == null || jar!!.size() != 2) {
        return "no-cookies"
    }
    if (jar!!.get(0).name != "sid") {
        return "bad-cookie"
    }
    if (stage == 16) {
        return "ok"
    }
    if (engine.addCookie(ctx, Cookie("n", "v", "shop.example.com")) == false) {
        return "no-add"
    }
    if (stage == 17) {
        return "ok"
    }
    val state = engine.storageState(ctx)
    if (state == null || state!!.indexOf("shop.example.com") < 0) {
        return "no-state"
    }
    if (stage == 18) {
        return "ok"
    }
    if (engine.clearCookies(ctx) == false) {
        return "no-clear"
    }
    if (stage == 19) {
        return "ok"
    }
    if (engine.subscribe(page, "request") == false) {
        return "no-sub"
    }
    if (engine.subscribe(page, "response") == false) {
        return "no-sub2"
    }
    if (engine.subscribe(page, "console") == false) {
        return "no-sub3"
    }
    if (engine.unsubscribe(page, "console") == false) {
        return "no-unsub"
    }
    val notes = drainWant(engine, 2)
    if (notes.size() != 2) {
        return "no-notes"
    }
    if (notes.get(0).indexOf("page.request") < 0) {
        return "bad-note-req"
    }
    if (notes.get(1).indexOf("page.response") < 0) {
        return "bad-note-res"
    }
    if (stage == 20) {
        return "ok"
    }
    if (engine.subscribe(page, "console") == false) {
        return "no-resub"
    }
    val notesC = drainUntil(engine, "hello-2")
    if (notesC.size() < 1) {
        return "no-con-note"
    }
    var fresh = false
    var c = 0
    while (c < notesC.size()) {
        if (notesC.get(c).indexOf("page.console") >= 0 && notesC.get(c).indexOf("hello-2") >= 0) {
            fresh = true
        }
        c = c + 1
    }
    if (fresh == false) {
        return "bad-con-note"
    }
    if (engine.subscribe(page, "download") == false) {
        return "no-sub-dl"
    }
    if (File.write(systemTempDir() + "/eiwa-dl-G7", "PDF-DATA") == false) {
        return "no-file"
    }
    val notes2 = drainWant(engine, 1)
    if (notes2.size() != 1) {
        return "no-dl-note"
    }
    if (notes2.get(0).indexOf("page.download") < 0) {
        return "bad-dl-note"
    }
    val raw = engine.downloadBytes("G7")
    if (raw == null) {
        return "no-bytes"
    }
    if (Encoding.base64UrlDecode(raw) != "PDF-DATA") {
        return "bad-bytes"
    }
    File.delete(systemTempDir() + "/eiwa-dl-G7")
    if (stage == 21) {
        return "ok"
    }
    if (engine.closePage(page) == false) {
        return "no-closepage"
    }
    if (engine.closeContext(ctx) == false) {
        return "no-closectx"
    }
    return "ok"
}

fun runStage(port: Int, stage: Int): String {
    val server = task {
        stageFake(port)
    }
    sleepMs(150)
    val client = task {
        driveStage(port, stage)
    }
    val res = client.await()
    server.await()
    return res
}

test "engine stages: context" {
    val r1 = runStage(19901, 1)
    assert(r1 == "ok", r1)
}

