import { assert } from "std.core"
import { JsonValue, parseJson } from "std.json"
import { sleepMs } from "std.time"
import { TCPServer, Socket } from "std.net"
import { List, MutableList } from "std.collections"
import { buildFrame, wsRecv, writeAll, WsClient, wsConnect } from ".browser.net.ws"
import { FrameReader } from ".browser.net.reader"
import { readHttpRequest, answerHandshake } from ".browser.net.ws_server"
import { requestFrame } from ".browser.protocol.envelope"
import { Chromium } from ".browser.chromium.chromium"
import { cdpConn } from ".browser.chromium.connection"
import { Engine } from ".browser.engine.engine"
import { Browser } from ".browser.browser"
import { serveOneEngine } from ".browser.worker.server"

fun liveReply(id: Int, result: String): String {
    return "{\"id\": $id, \"result\": $result}"
}

fun liveSession(sock: Socket): String {
    var open = true
    while (open) {
        val f = wsRecv(sock)
        if (f == null) {
            return "closed"
        }
        if (f.opcode == 8) {
            return "ok"
        }
        if (f.opcode == 1) {
            val msg = parseJson(f.payload)
            val id = msg.get("id")
            if (id != null && id!!.isNumber()) {
                val num = id!!.asNumber().toInt()
                val method = msg.get("method")
                if (method != null && method!!.isString()) {
                    val name = method!!.asString()
                    if (name == "Target.createBrowserContext") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["browserContextId" of "CB1"].toJson()), null))
                    } else if (name == "Target.disposeBrowserContext") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Target.createTarget") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["targetId" of "T1"].toJson()), null))
                    } else if (name == "Target.attachToTarget") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["sessionId" of "S1"].toJson()), null))
                    } else if (name == "Target.closeTarget") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Page.enable") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Page.navigate") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["frameId" of "F1"].toJson()), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Network.requestWillBeSent\", \"params\": {\"requestId\": \"req-1\", \"request\": {\"url\": \"https://example.com\", \"method\": \"GET\"}}, \"sessionId\": \"S1\"}", null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Network.responseReceived\", \"params\": {\"requestId\": \"req-1\", \"response\": {\"url\": \"https://example.com\", \"status\": 200}}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Page.reload") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Page.getNavigationHistory") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{\"currentIndex\": 1, \"entries\": [{\"id\": 101}, {\"id\": 102}, {\"id\": 103}]}"), null))
                    } else if (name == "Page.navigateToHistoryEntry") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Input.dispatchKeyEvent" || name == "Input.insertText") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Storage.getCookies") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{\"cookies\": [{\"name\": \"sid\", \"value\": \"abc\", \"domain\": \"shop.example.com\"}]}"), null))
                    } else if (name == "Storage.setCookies" || name == "Storage.clearCookies") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Network.enable" || name == "Runtime.enable") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                        if (name == "Runtime.enable") {
                            writeAll(sock, buildFrame(1, "{\"method\": \"Runtime.consoleAPICalled\", \"params\": {\"type\": \"log\", \"args\": [{\"type\": \"string\", \"value\": \"hello\"}]}, \"sessionId\": \"S1\"}", null))
                        }
                    } else if (name == "Browser.setDownloadBehavior") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Browser.downloadWillBegin\", \"params\": {\"frameId\": \"F1\", \"guid\": \"G7\", \"url\": \"https://example.com/f.pdf\", \"suggestedFilename\": \"f.pdf\"}}", null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Browser.downloadProgress\", \"params\": {\"guid\": \"G7\", \"totalBytes\": 8, \"receivedBytes\": 8, \"state\": \"completed\"}}", null))
                    } else if (name == "Runtime.evaluate") {
                        if (f.payload.indexOf("el.focus") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"ok\"}}"), null))
                        } else if (f.payload.indexOf("getBoundingClientRect") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"found\"}}"), null))
                        } else if (f.payload.indexOf("window.location.href") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"https://shop.example/result/1\"}}"), null))
                        } else if (f.payload.indexOf("el.click") >= 0 || f.payload.indexOf("el.value") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"ok\"}}"), null))
                        } else if (f.payload.indexOf("getAttribute") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"A\"}}"), null))
                        } else if (f.payload.indexOf("outerHTML") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"<h1>H</h1>\"}}"), null))
                        } else if (f.payload.indexOf("() => 42") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"number\", \"value\": 42}}"), null))
                        } else {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"Live heading\"}}"), null))
                        }
                    } else {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    }
                }
            }
        }
    }
    return "closed"
}

fun liveFakeCdp(port: Int): String {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return "bind-fail"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val head = readHttpRequest(conn)
    if (head == null) {
        server.close()
        return "read-fail"
    }
    if (answerHandshake(conn, head) == false) {
        server.close()
        return "handshake-fail"
    }
    val out = liveSession(conn)
    conn.close()
    server.close()
    return out
}

fun buildTestEngine(port: Int): Engine? {
    var tries = 0
    while (tries < 50) {
        val ws = wsConnect("127.0.0.1", port, "/fake")
        if (ws != null) {
            return Engine(Chromium("fake", 0, -1), cdpConn(ws))
        }
        sleepMs(100)
        tries = tries + 1
    }
    return null
}

// Notifications skipped while awaiting a reply are stashed here instead
// of dropped, so shared-reader RPC helpers never lose interleaved notes.
type NoteStash(var items: MutableList<String> = MutableList<String>()) {

    fun put(method: String): Void {
        this.items.add(method)
    }

    fun takeAll(): List<String> {
        val out = this.items
        this.items = MutableList<String>()
        return out.freeze()
    }
}

fun collectNotes(ws: WsClient, reader: FrameReader? = null, want: Int = 0, timeoutMs: Int = 5000, stash: NoteStash? = null): List<String> {
    val out: MutableList<String> = MutableList<String>()
    if (stash != null) {
        val saved = stash.takeAll()
        var k = 0
        while (k < saved.size()) {
            out.add(saved.get(k))
            k = k + 1
        }
    }
    val r = if (reader == null) { FrameReader(ws.socket, "") } else { reader }
    var left = timeoutMs
    var tries = 0
    while (tries < 20 && left > 0 && (want <= 0 || out.size() < want)) {
        val f = r.readFrame(200)
        if (f == null) {
            return out.freeze()
        }
        if (f.opcode == 1 || f.opcode == 2) {
            val msg = parseJson(f.payload)
            if (msg.get("id") == null) {
                val method = msg.get("method")
                if (method != null && method!!.isString()) {
                    out.add(method!!.asString())
                }
            }
        }
        left = left - 200
        tries = tries + 1
    }
    return out.freeze()
}

// Poll-style collection: each pass reads what arrived, then a cheap
// read RPC triggers the worker's after-dispatch flush for stragglers.
// Wire order is preserved across passes.
fun collectWant(ws: WsClient, page: String, reader: FrameReader, want: Int, baseId: Int, stash: NoteStash): List<String> {
    val out: MutableList<String> = MutableList<String>()
    var round = 0
    while (round < 12 && out.size() < want) {
        val notes = collectNotes(ws, reader, want - out.size(), 1000, stash)
        var i = 0
        while (i < notes.size()) {
            out.add(notes.get(i))
            i = i + 1
        }
        if (out.size() < want) {
            val pumpId = baseId + round
            rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": $pumpId, \"method\": \"page.content\", \"params\": {\"page\": \"$page\"}}", reader, stash)
        }
        round = round + 1
    }
    return out.freeze()
}

fun rpcField(ws: WsClient, frame: String, key: String, reader: FrameReader? = null, stash: NoteStash? = null): String? {
    if (ws.sendText(frame) == false) {
        return null
    }
    val r = if (reader == null) { FrameReader(ws.socket, "") } else { reader }
    var tries = 0
    while (tries < 10) {
        val f = r.readFrame(2000)
        if (f == null) {
            return null
        }
        if (f.opcode == 1 || f.opcode == 2) {
            val msg = parseJson(f.payload)
            if (msg.get("id") != null) {
                val res = msg.get("result")
                if (res != null) {
                    val field = res!!.get(key)
                    if (field != null && field!!.isString()) {
                        return field!!.asString()
                    }
                }
            } else {
                stashNote(stash, msg)
            }
        }
        tries = tries + 1
    }
    return null
}

fun stashNote(stash: NoteStash? = null, msg: JsonValue? = null): Void {
    if (stash == null || msg == null) {
        return
    }
    val method = msg!!.get("method")
    if (method != null && method!!.isString()) {
        stash.put(method!!.asString())
    }
}

fun rpcOk(ws: WsClient, frame: String, reader: FrameReader? = null, stash: NoteStash? = null): Bool {
    val got = rpcRaw(ws, frame, reader, stash)
    if (got == null) {
        return false
    }
    return parseJson(got).get("result") != null
}

fun rpcRaw(ws: WsClient, frame: String, reader: FrameReader? = null, stash: NoteStash? = null): String? {
    if (ws.sendText(frame) == false) {
        return null
    }
    val r = if (reader == null) { FrameReader(ws.socket, "") } else { reader }
    var tries = 0
    while (tries < 10) {
        val f = r.readFrame(2000)
        if (f == null) {
            return null
        }
        if (f.opcode == 1 || f.opcode == 2) {
            val msg = parseJson(f.payload)
            if (msg.get("id") != null) {
                return f.payload
            }
            stashNote(stash, msg)
        }
        tries = tries + 1
    }
    return null
}

fun wsConnectRetry(port: Int, path: String): WsClient? {
    var tries = 0
    while (tries < 50) {
        val ws = wsConnect("127.0.0.1", port, path)
        if (ws != null) {
            return ws
        }
        sleepMs(100)
        tries = tries + 1
    }
    return null
}

fun workerSide(portA: Int, server: TCPServer): String {
    val engine = buildTestEngine(portA)
    if (engine == null) {
        return "no-engine"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val out = serveOneEngine(conn, engine)
    engine.conn.close()
    server.close()
    return out
}

fun clientStage(portB: Int, stage: Int): String {
    val ws = wsConnectRetry(portB, "/")
    if (ws == null) {
        return "no-conn"
    }
    val ctx = rpcField(ws, requestFrame(1, "browser.newContext", "{}"), "context")
    if (ctx == null) {
        ws.close()
        return "no-ctx"
    }
    if (stage == 1) {
        ws.close()
        return "ok-1"
    }
    val page = rpcField(ws, "{\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"context.newPage\", \"params\": {\"context\": \"$ctx\"}}", "page")
    if (page == null) {
        ws.close()
        return "no-page"
    }
    if (stage == 2) {
        ws.close()
        return "ok-2"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 3, \"method\": \"page.goto\", \"params\": {\"page\": \"$page\", \"url\": \"https://example.com\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-goto"
    }
    if (stage == 3) {
        ws.close()
        return "ok-3"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 4, \"method\": \"page.reload\", \"params\": {\"page\": \"$page\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-reload"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 5, \"method\": \"page.goBack\", \"params\": {\"page\": \"$page\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-back"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 6, \"method\": \"page.goForward\", \"params\": {\"page\": \"$page\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-forward"
    }
    if (stage == 4) {
        ws.close()
        return "ok-4"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 7, \"method\": \"page.text\", \"params\": {\"page\": \"$page\"}}") == false) {
        ws.close()
        return "no-text"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 8, \"method\": \"page.text\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"h1\"}}}") == false) {
        ws.close()
        return "no-scoped-text"
    }
    if (stage == 5) {
        ws.close()
        return "ok-5"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 9, \"method\": \"page.click\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"#go\"}}}") == false) {
        ws.close()
        return "no-click"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 10, \"method\": \"page.fill\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"#q\"}, \"value\": \"hi\"}}") == false) {
        ws.close()
        return "no-fill"
    }
    if (rpcField(ws, "{\"jsonrpc\": \"2.0\", \"id\": 11, \"method\": \"page.attribute\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"a\"}, \"name\": \"href\"}}", "value") != "A") {
        ws.close()
        return "no-attr"
    }
    if (rpcField(ws, "{\"jsonrpc\": \"2.0\", \"id\": 12, \"method\": \"page.content\", \"params\": {\"page\": \"$page\"}}", "html") != "<h1>H</h1>") {
        ws.close()
        return "no-content"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 13, \"method\": \"page.evaluate\", \"params\": {\"page\": \"$page\", \"script\": \"() => 42\"}}") == false) {
        ws.close()
        return "no-eval"
    }
    if (stage == 6) {
        ws.close()
        return "ok-6"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 14, \"method\": \"page.waitFor\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \".product-detail\"}, \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-wait"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 15, \"method\": \"page.waitForUrl\", \"params\": {\"page\": \"$page\", \"pattern\": \"**/result/**\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-wait-url"
    }
    if (stage == 7) {
        ws.close()
        return "ok-7"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 16, \"method\": \"page.press\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"#q\"}, \"key\": \"Enter\"}}") == false) {
        ws.close()
        return "no-press"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 17, \"method\": \"page.press\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"#q\"}, \"key\": \"a\"}}") == false) {
        ws.close()
        return "no-press-char"
    }
    if (stage == 8) {
        ws.close()
        return "ok-8"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 18, \"method\": \"context.cookies\", \"params\": {\"context\": \"$ctx\"}}") == false) {
        ws.close()
        return "no-cookies"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 19, \"method\": \"context.addCookie\", \"params\": {\"context\": \"$ctx\", \"cookie\": {\"name\": \"n\", \"value\": \"v\", \"domain\": \"shop.example.com\"}}}") == false) {
        ws.close()
        return "no-add"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 20, \"method\": \"context.storageState\", \"params\": {\"context\": \"$ctx\"}}") == false) {
        ws.close()
        return "no-state"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 21, \"method\": \"context.clearCookies\", \"params\": {\"context\": \"$ctx\"}}") == false) {
        ws.close()
        return "no-clear"
    }
    if (stage == 9) {
        ws.close()
        return "ok-9"
    }
    val shared = FrameReader(ws.socket, "")
    val stash = NoteStash()
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 22, \"method\": \"page.subscribe\", \"params\": {\"page\": \"$page\", \"topic\": \"request\"}}", shared, stash) == false) {
        ws.close()
        return "no-sub"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 23, \"method\": \"page.subscribe\", \"params\": {\"page\": \"$page\", \"topic\": \"response\"}}", shared, stash) == false) {
        ws.close()
        return "no-sub2"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 24, \"method\": \"page.subscribe\", \"params\": {\"page\": \"$page\", \"topic\": \"console\"}}", shared, stash) == false) {
        ws.close()
        return "no-sub3"
    }
    // Pushed events can stall behind delayed ACKs; collectWant polls
    // (read pass + flush-pump RPC) until both land, in wire order.
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 25, \"method\": \"page.subscribe\", \"params\": {\"page\": \"$page\", \"topic\": \"download\"}}", shared, stash) == false) {
        ws.close()
        return "no-sub-dl"
    }
    sleepMs(200)
    val notes = collectWant(ws, page, shared, 2, 28, stash)
    if (notes.size() != 2) {
        var seen = ""
        var q = 0
        while (q < notes.size()) {
            seen = seen + notes.get(q) + ";"
            q = q + 1
        }
        ws.close()
        return "bad-notes-size-" + notes.size().toString() + "-" + seen
    }
    if (notes.get(0) != "page.console" || notes.get(1) != "page.download") {
        ws.close()
        return "bad-notes-content-" + notes.get(0) + "-" + notes.get(1)
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 26, \"method\": \"page.goto\", \"params\": {\"page\": \"$page\", \"url\": \"https://example.com\", \"timeoutMs\": 5000}}", shared, stash) == false) {
        ws.close()
        return "no-goto2"
    }
    val notes2 = collectWant(ws, page, shared, 2, 40, stash)
    if (notes2.size() != 2) {
        ws.close()
        return "bad-net-notes-size"
    }
    if (notes2.get(0) != "page.request" || notes2.get(1) != "page.response") {
        ws.close()
        return "bad-net-notes-content"
    }
    ws.close()
    return "ok-10"
}

fun workerCase(portA: Int, portB: Int, stage: Int, want: String): String {
    val cdp = task {
        liveFakeCdp(portA)
    }
    sleepMs(150)
    val server = TCPServer()
    if (server.bind(portB) == false) {
        cdp.await()
        return "bind-fail"
    }
    val worker = task {
        workerSide(portA, server)
    }
    sleepMs(150)
    val client = task {
        clientStage(portB, stage)
    }
    val res = client.await()
    worker.await()
    cdp.await()
    if (res != want) {
        return res
    }
    return "ok"
}

test "worker stages: context and page" {
    assert(workerCase(19921, 19922, 2, "ok-2") == "ok")
}

test "worker stages: goto" {
    assert(workerCase(19923, 19924, 3, "ok-3") == "ok")
}

test "worker stages: reload and history" {
    assert(workerCase(19925, 19926, 4, "ok-4") == "ok")
}

test "worker stages: text" {
    assert(workerCase(19927, 19928, 5, "ok-5") == "ok")
}

test "worker stages: actions and reading" {
    assert(workerCase(19929, 19930, 6, "ok-6") == "ok")
}

test "worker stages: waits" {
    assert(workerCase(19935, 19936, 7, "ok-7") == "ok")
}

test "worker stages: press" {
    assert(workerCase(19937, 19938, 8, "ok-8") == "ok")
}

test "worker stages: cookies and state" {
    assert(workerCase(19939, 19940, 9, "ok-9") == "ok")
}

test "worker stages: events" {
    val r = workerCase(19943, 19944, 10, "ok-10")
    assert(r == "ok", r)
}

test "worker stages: version, connectivity and remote close" {
    val cdp = task {
        liveFakeCdp(19945)
    }
    sleepMs(150)
    val server = TCPServer()
    assert(server.bind(19946))
    val worker = task {
        workerSide(19945, server)
    }
    sleepMs(150)
    val browser = Browser(["ws://127.0.0.1:19946"], 1)
    assert(browser.isConnected() == false, "lazy")
    assert(browser.version() == "1.0", "version")
    assert(browser.isConnected(), "connected")
    val ctx = browser.newContext()
    val pg = ctx.newPage()
    assert(pg.goto("https://example.com"), "goto")
    pg.close()
    assert(ctx.pages().size() == 0, "page-gone")
    ctx.close()
    assert(browser.contexts().size() == 0, "ctx-gone")
    browser.close()
    assert(browser.isConnected() == false, "closed")
    worker.await()
    cdp.await()
}
