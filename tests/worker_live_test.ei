import { assert } from "std.core"
import { parseJson } from "std.json"
import { sleepMs } from "std.time"
import { TCPServer, Socket } from "std.net"
import { buildFrame, wsRecv, writeAll, WsClient, wsConnect } from ".browser.net.ws"
import { FrameReader } from ".browser.net.reader"
import { readHttpRequest, answerHandshake } from ".browser.net.ws_server"
import { requestFrame } from ".browser.protocol.envelope"
import { Chromium } from ".browser.chromium.chromium"
import { cdpConn } from ".browser.chromium.connection"
import { Engine } from ".browser.engine.engine"
import { serveOneEngine } from ".browser.worker.server"

fun liveReply(id: Int, result: String): String {
    return "{\"id\": $id, \"result\": $result}"
}

fun liveSession(sock: Socket): String {
    var open = true
    while (open) {
        val f = wsRecv(sock)
        if (f == null) {
            return "closed"
        }
        if (f.opcode == 8) {
            return "ok"
        }
        if (f.opcode == 1) {
            val msg = parseJson(f.payload)
            val id = msg.get("id")
            if (id != null && id!!.isNumber()) {
                val num = id!!.asNumber().toInt()
                val method = msg.get("method")
                if (method != null && method!!.isString()) {
                    val name = method!!.asString()
                    if (name == "Target.createBrowserContext") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["browserContextId" of "CB1"].toJson()), null))
                    } else if (name == "Target.disposeBrowserContext") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Target.createTarget") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["targetId" of "T1"].toJson()), null))
                    } else if (name == "Target.attachToTarget") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["sessionId" of "S1"].toJson()), null))
                    } else if (name == "Target.closeTarget") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Page.enable") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    } else if (name == "Page.navigate") {
                        writeAll(sock, buildFrame(1, liveReply(num, ["frameId" of "F1"].toJson()), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Page.reload") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Page.getNavigationHistory") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{\"currentIndex\": 1, \"entries\": [{\"id\": 101}, {\"id\": 102}, {\"id\": 103}]}"), null))
                    } else if (name == "Page.navigateToHistoryEntry") {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                        writeAll(sock, buildFrame(1, "{\"method\": \"Page.loadEventFired\", \"params\": {}, \"sessionId\": \"S1\"}", null))
                    } else if (name == "Runtime.evaluate") {
                        if (f.payload.indexOf("getBoundingClientRect") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"found\"}}"), null))
                        } else if (f.payload.indexOf("window.location.href") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"https://shop.example/result/1\"}}"), null))
                        } else if (f.payload.indexOf("el.click") >= 0 || f.payload.indexOf("el.value") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"ok\"}}"), null))
                        } else if (f.payload.indexOf("getAttribute") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"A\"}}"), null))
                        } else if (f.payload.indexOf("outerHTML") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"<h1>H</h1>\"}}"), null))
                        } else if (f.payload.indexOf("() => 42") >= 0) {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"number\", \"value\": 42}}"), null))
                        } else {
                            writeAll(sock, buildFrame(1, liveReply(num, "{\"result\": {\"type\": \"string\", \"value\": \"Live heading\"}}"), null))
                        }
                    } else {
                        writeAll(sock, buildFrame(1, liveReply(num, "{}"), null))
                    }
                }
            }
        }
    }
    return "closed"
}

fun liveFakeCdp(port: Int): String {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return "bind-fail"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val head = readHttpRequest(conn)
    if (head == null) {
        server.close()
        return "read-fail"
    }
    if (answerHandshake(conn, head) == false) {
        server.close()
        return "handshake-fail"
    }
    val out = liveSession(conn)
    conn.close()
    server.close()
    return out
}

fun buildTestEngine(port: Int): Engine? {
    var tries = 0
    while (tries < 50) {
        val ws = wsConnect("127.0.0.1", port, "/fake")
        if (ws != null) {
            return Engine(Chromium("fake", 0, -1), cdpConn(ws))
        }
        sleepMs(100)
        tries = tries + 1
    }
    return null
}

fun rpcField(ws: WsClient, frame: String, key: String): String? {
    if (ws.sendText(frame) == false) {
        return null
    }
    val reader = FrameReader(ws.socket, "")
    var tries = 0
    while (tries < 10) {
        val f = reader.readFrame(2000)
        if (f == null) {
            return null
        }
        if (f.opcode == 1 || f.opcode == 2) {
            val msg = parseJson(f.payload)
            val res = msg.get("result")
            if (res != null) {
                val field = res!!.get(key)
                if (field != null && field!!.isString()) {
                    return field!!.asString()
                }
            }
        }
        tries = tries + 1
    }
    return null
}

fun rpcOk(ws: WsClient, frame: String): Bool {
    val got = rpcRaw(ws, frame)
    if (got == null) {
        return false
    }
    return parseJson(got).get("result") != null
}

fun rpcRaw(ws: WsClient, frame: String): String? {
    if (ws.sendText(frame) == false) {
        return null
    }
    val reader = FrameReader(ws.socket, "")
    var tries = 0
    while (tries < 10) {
        val f = reader.readFrame(2000)
        if (f == null) {
            return null
        }
        if (f.opcode == 1 || f.opcode == 2) {
            return f.payload
        }
        tries = tries + 1
    }
    return null
}

fun wsConnectRetry(port: Int, path: String): WsClient? {
    var tries = 0
    while (tries < 50) {
        val ws = wsConnect("127.0.0.1", port, path)
        if (ws != null) {
            return ws
        }
        sleepMs(100)
        tries = tries + 1
    }
    return null
}

fun workerSide(portA: Int, server: TCPServer): String {
    val engine = buildTestEngine(portA)
    if (engine == null) {
        return "no-engine"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val out = serveOneEngine(conn, engine)
    engine.conn.close()
    server.close()
    return out
}

fun clientStage(portB: Int, stage: Int): String {
    val ws = wsConnectRetry(portB, "/")
    if (ws == null) {
        return "no-conn"
    }
    val ctx = rpcField(ws, requestFrame(1, "browser.newContext", "{}"), "context")
    if (ctx == null) {
        ws.close()
        return "no-ctx"
    }
    if (stage == 1) {
        ws.close()
        return "ok-1"
    }
    val page = rpcField(ws, "{\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"context.newPage\", \"params\": {\"context\": \"$ctx\"}}", "page")
    if (page == null) {
        ws.close()
        return "no-page"
    }
    if (stage == 2) {
        ws.close()
        return "ok-2"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 3, \"method\": \"page.goto\", \"params\": {\"page\": \"$page\", \"url\": \"https://example.com\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-goto"
    }
    if (stage == 3) {
        ws.close()
        return "ok-3"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 4, \"method\": \"page.reload\", \"params\": {\"page\": \"$page\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-reload"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 5, \"method\": \"page.goBack\", \"params\": {\"page\": \"$page\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-back"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 6, \"method\": \"page.goForward\", \"params\": {\"page\": \"$page\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-forward"
    }
    if (stage == 4) {
        ws.close()
        return "ok-4"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 7, \"method\": \"page.text\", \"params\": {\"page\": \"$page\"}}") == false) {
        ws.close()
        return "no-text"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 8, \"method\": \"page.text\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"h1\"}}}") == false) {
        ws.close()
        return "no-scoped-text"
    }
    if (stage == 5) {
        ws.close()
        return "ok-5"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 9, \"method\": \"page.click\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"#go\"}}}") == false) {
        ws.close()
        return "no-click"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 10, \"method\": \"page.fill\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"#q\"}, \"value\": \"hi\"}}") == false) {
        ws.close()
        return "no-fill"
    }
    if (rpcField(ws, "{\"jsonrpc\": \"2.0\", \"id\": 11, \"method\": \"page.attribute\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \"a\"}, \"name\": \"href\"}}", "value") != "A") {
        ws.close()
        return "no-attr"
    }
    if (rpcField(ws, "{\"jsonrpc\": \"2.0\", \"id\": 12, \"method\": \"page.content\", \"params\": {\"page\": \"$page\"}}", "html") != "<h1>H</h1>") {
        ws.close()
        return "no-content"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 13, \"method\": \"page.evaluate\", \"params\": {\"page\": \"$page\", \"script\": \"() => 42\"}}") == false) {
        ws.close()
        return "no-eval"
    }
    if (stage == 6) {
        ws.close()
        return "ok-6"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 14, \"method\": \"page.waitFor\", \"params\": {\"page\": \"$page\", \"locator\": {\"strategy\": \"css\", \"selector\": \".product-detail\"}, \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-wait"
    }
    if (rpcOk(ws, "{\"jsonrpc\": \"2.0\", \"id\": 15, \"method\": \"page.waitForUrl\", \"params\": {\"page\": \"$page\", \"pattern\": \"**/result/**\", \"timeoutMs\": 5000}}") == false) {
        ws.close()
        return "no-wait-url"
    }
    ws.close()
    return "ok-7"
}

fun workerCase(portA: Int, portB: Int, stage: Int, want: String): String {
    val cdp = task {
        liveFakeCdp(portA)
    }
    sleepMs(150)
    val server = TCPServer()
    if (server.bind(portB) == false) {
        cdp.await()
        return "bind-fail"
    }
    val worker = task {
        workerSide(portA, server)
    }
    sleepMs(150)
    val client = task {
        clientStage(portB, stage)
    }
    val res = client.await()
    worker.await()
    cdp.await()
    if (res != want) {
        return res
    }
    return "ok"
}

test "worker stages: context and page" {
    assert(workerCase(19921, 19922, 2, "ok-2") == "ok")
}

test "worker stages: goto" {
    assert(workerCase(19923, 19924, 3, "ok-3") == "ok")
}

test "worker stages: reload and history" {
    assert(workerCase(19925, 19926, 4, "ok-4") == "ok")
}

test "worker stages: text" {
    assert(workerCase(19927, 19928, 5, "ok-5") == "ok")
}

test "worker stages: actions and reading" {
    assert(workerCase(19929, 19930, 6, "ok-6") == "ok")
}

test "worker stages: waits" {
    assert(workerCase(19935, 19936, 7, "ok-7") == "ok")
}
