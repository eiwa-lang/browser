// Reference scraping service (generic consumer, outside browser scope).
// HTTP-first fallback + pool via Browser + normalization in-app.
import { Browser, NoWorkerAvailable, UnknownContext } from ".browser.browser"
import { Log } from "std.log"
import { css } from ".browser.locator.locator"
import { gotoCmd, textCmd } from ".browser.protocol.commands"
import { httpGet } from ".browser.net.http"

// App-owned: raw text in, normalized record out.
fun normalize(raw: String): String {
    return raw
}

fun main() {
    val http = httpGet("shop.example.com", 80, "/api/products/sku-1")
    if (http != null && http.status == 200) {
        normalize(http.body)
        return
    }
    val browser = Browser(["ws://browser-worker:8080"], 8)
    try {
        val page = browser.newPage()
        val goto = gotoCmd(1, page.id, "https://shop.example.com", "load", 30000)
        val text = textCmd(2, page.id, css(".product-detail"))
        normalize("")
    } catch (e: NoWorkerAvailable | UnknownContext) {
        Log.error(e) { "browser provisioning failed" }
    }
    browser.close()
}
