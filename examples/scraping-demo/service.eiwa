// Reference scraping service (generic consumer, outside browser scope).
// HTTP-first fallback + pool via Browser.connect + normalization in-app.
use browser
use arest

val browser = Browser.connect(
    workers: ["ws://browser-worker:8080"],
    poolSize: 8
)

scraper ProductScraper

searchProduct(sku) {
    // 1. HTTP first when an authorized interface exists.
    val res = httpGet("https://shop.example.com/api/products/$sku")
    if (res.ok) {
        return normalize(res.body())
    }

    // 2. Fallback to browser automation.
    val context = browser.newContext()
    try
        val page = context.newPage()
        try
            page.goto("https://shop.example.com")

            page.locator("#search-box").fill(sku)
            page.locator("#search-button").click()
            page.waitFor(".product-detail")

            // 3. Raw artifacts only; normalize + persist in THIS service.
            val raw = page.locator(".product-detail").text()
            return normalize(raw)
        finally
            page.close()
        end
    finally
        context.close()
    end
}
