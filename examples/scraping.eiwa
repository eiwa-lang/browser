// Scraping: locators, explicit waits, JS evaluation.
use browser

val browser = Browser.connect(
    workers: ["ws://browser-worker:8080"],
    poolSize: 8
)

val context = browser.newContext()
val page = context.newPage()

page.goto("https://example.com/process/123")

page.waitFor(".process-result")

val number = page.locator(".number").text()
val subject = page.locator(".subject").text()
val html = page.locator(".process-result").innerHtml()

val title = page.evaluate("() => document.title")
print("$number | $subject | $title")

page.close()
context.close()
browser.close()
