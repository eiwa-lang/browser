// Scraping: locators, timeout scopes, waits, evaluation frames.
import { Browser, NoWorkerAvailable, UnknownContext } from ".browser.browser"
import { Log } from "std.log"
import { parseLocator } from ".browser.locator.locator"
import { TimeoutConfig, resolveTimeout } from ".browser.timeouts"
import { waitForCmd, evaluateCmd } from ".browser.protocol.commands"

fun main() {
    try {
        use(Browser(["ws://browser-worker:8080"], 8)) { browser ->
            val page = browser.newPage()
            val loc = parseLocator(".product-detail")
            val timeouts = TimeoutConfig()
            timeouts.set("actionTimeout", 5000)
            val wait = waitForCmd(1, page.id, loc.selector, resolveTimeout("actionTimeout", [timeouts]))
            val title = evaluateCmd(2, page.id, "document.title")
        }
    } catch (e: NoWorkerAvailable | UnknownContext) {
        Log.error(e) { "browser provisioning failed" }
    }
}
