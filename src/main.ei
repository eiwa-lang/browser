import { Env } from "std.env"
import { sleepMs } from "std.time"
import { serve, serveEngine } from ".browser.worker.server"
import { launchChromium } from ".browser.chromium.chromium"
import { attachDevtools } from ".browser.chromium.connection"
import { Engine } from ".browser.engine.engine"

fun chromiumPort(): Int {
    return Env.get("CHROMIUM_PORT", 9333)
}

fun chromiumExe(): String {
    val exe = Env.get("CHROMIUM_EXE")
    if (exe == null) {
        return "chromium"
    }
    return exe
}

fun bootEngine(): Engine? {
    val exe = chromiumExe()
    val port = chromiumPort()
    var tries = 0
    while (tries < 60) {
        val c = launchChromium(exe, port)
        if (c != null) {
            val conn = attachDevtools("127.0.0.1", port)
            if (conn != null) {
                return Engine(c, conn)
            }
            c.stop()
        }
        sleepMs(1000)
        tries = tries + 1
    }
    return null
}

fun main() {
    val port = Env.get("PORT", 8080)
    val engine = bootEngine()
    if (engine == null) {
        serve(port, -1)
    } else {
        serveEngine(port, engine, -1)
    }
}
