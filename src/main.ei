import { Env } from "std.env"
import { serve, serveEngine } from ".browser.worker.server"
import { ChromiumAdapter } from ".browser.chromium.adapter"
import { Engine } from ".browser.engine.engine"

fun chromiumPort(): Int {
    return Env.get("CHROMIUM_PORT", 9333)
}

fun chromiumExe(): String {
    val exe = Env.get("CHROMIUM_EXE")
    if (exe == null) {
        return "chromium"
    }
    return exe
}

fun bootEngine(): Engine? {
    return ChromiumAdapter(chromiumExe(), chromiumPort()).boot()
}

fun main() {
    val port = Env.get("PORT", 8080)
    val engine = bootEngine()
    if (engine == null) {
        serve(port, -1)
    } else {
        serveEngine(port, engine, -1)
    }
}
