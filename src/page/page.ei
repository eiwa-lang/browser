// Page handle (§6.3): a browser tab inside a context.

import { Closeable } from "std.core"
import { MutableMap } from "std.collections"
import { JsonValue, jsonObject, jsonString, jsonNumber, parseJson } from "std.json"
import { Browser } from ".browser.browser"
import { Locator, locatorValue, parseLocator } from ".browser.locator.locator"
import { ObservedRequest, ObservedResponse } from ".browser.network.network"
import { ConsoleEvent } from ".browser.challenge.challenge"
import { Download } from ".browser.storage.state"

fun pageParams(page: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    return jsonObject(m.freeze()).write()
}

fun locatorParams(page: String, loc: Locator): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("locator", locatorValue(loc))
    return jsonObject(m.freeze()).write()
}

fun locatorValueParams(page: String, loc: Locator, value: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("locator", locatorValue(loc))
    m.put("value", jsonString(value))
    return jsonObject(m.freeze()).write()
}

fun locatorNameParams(page: String, loc: Locator, name: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("locator", locatorValue(loc))
    m.put("name", jsonString(name))
    return jsonObject(m.freeze()).write()
}

fun locatorKeyParams(page: String, loc: Locator, key: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("locator", locatorValue(loc))
    m.put("key", jsonString(key))
    return jsonObject(m.freeze()).write()
}

fun scriptParams(page: String, script: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("script", jsonString(script))
    return jsonObject(m.freeze()).write()
}

fun timeoutParams(page: String, timeoutMs: Int): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("timeoutMs", jsonNumber(timeoutMs.toDouble()))
    return jsonObject(m.freeze()).write()
}

fun locatorTimeoutParams(page: String, loc: Locator, timeoutMs: Int): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("locator", locatorValue(loc))
    m.put("timeoutMs", jsonNumber(timeoutMs.toDouble()))
    return jsonObject(m.freeze()).write()
}

fun patternParams(page: String, pattern: String, timeoutMs: Int): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("pattern", jsonString(pattern))
    m.put("timeoutMs", jsonNumber(timeoutMs.toDouble()))
    return jsonObject(m.freeze()).write()
}

fun gotoParams(page: String, url: String, waitUntil: String, timeoutMs: Int): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("url", jsonString(url))
    m.put("waitUntil", jsonString(waitUntil))
    m.put("timeoutMs", jsonNumber(timeoutMs.toDouble()))
    return jsonObject(m.freeze()).write()
}

type Page(
    val browser: Browser,
    val id: String,
    val context: String,
    var reqHandler: ((ObservedRequest) -> Void)? = null,
    var resHandler: ((ObservedResponse) -> Void)? = null,
    var conHandler: ((ConsoleEvent) -> Void)? = null,
    var dlHandler: ((Download) -> Void)? = null
) : Closeable {

    fun locator(raw: String): Locator {
        val parsed = parseLocator(raw)
        return Locator(parsed.strategy, parsed.selector, this)
    }

    fun text(loc: Locator? = null): String? {
        if (loc == null) {
            return this.readTextResult(this.browser.callPage(this, "page.text", { rid ->
                "{\"page\": \"" + rid + "\"}"
            }))
        }
        val target = loc
        return this.readTextResult(this.browser.callPage(this, "page.text", { rid ->
            "{\"page\": \"" + rid + "\", \"locator\": " + target.param() + "}"
        }))
    }

    fun readTextResult(res: String?): String? {
        if (res == null) {
            return null
        }
        val t = parseJson(res).get("text")
        if (t == null || t!!.isString() == false) {
            return null
        }
        return t!!.asString()
    }

    fun goto(url: String, waitUntil: String = "load", timeoutMs: Int = 30000): Bool {
        val res = this.browser.callPage(this, "page.goto", { rid ->
            gotoParams(rid, url, waitUntil, timeoutMs)
        })
        return res != null
    }

    fun reload(timeoutMs: Int = 30000): Bool {
        val res = this.browser.callPage(this, "page.reload", { rid ->
            timeoutParams(rid, timeoutMs)
        })
        return res != null
    }

    fun goBack(timeoutMs: Int = 30000): Bool {
        val res = this.browser.callPage(this, "page.goBack", { rid ->
            timeoutParams(rid, timeoutMs)
        })
        return res != null
    }

    fun goForward(timeoutMs: Int = 30000): Bool {
        val res = this.browser.callPage(this, "page.goForward", { rid ->
            timeoutParams(rid, timeoutMs)
        })
        return res != null
    }

    fun click(loc: Locator): Bool {
        val res = this.browser.callPage(this, "page.click", { rid ->
            locatorParams(rid, loc)
        })
        return res != null
    }

    fun fill(loc: Locator, value: String): Bool {
        val res = this.browser.callPage(this, "page.fill", { rid ->
            locatorValueParams(rid, loc, value)
        })
        return res != null
    }

    fun typeText(loc: Locator, value: String): Bool {
        val res = this.browser.callPage(this, "page.typeText", { rid ->
            locatorValueParams(rid, loc, value)
        })
        return res != null
    }

    fun press(loc: Locator, key: String): Bool {
        val res = this.browser.callPage(this, "page.press", { rid ->
            locatorKeyParams(rid, loc, key)
        })
        return res != null
    }

    fun attribute(loc: Locator, name: String): String? {
        val res = this.browser.callPage(this, "page.attribute", { rid ->
            locatorNameParams(rid, loc, name)
        })
        if (res == null) {
            return null
        }
        val v = parseJson(res).get("value")
        if (v == null || v!!.isString() == false) {
            return null
        }
        return v!!.asString()
    }

    fun content(): String? {
        val res = this.browser.callPage(this, "page.content", { rid ->
            pageParams(rid)
        })
        if (res == null) {
            return null
        }
        val h = parseJson(res).get("html")
        if (h == null || h!!.isString() == false) {
            return null
        }
        return h!!.asString()
    }

    fun evaluate(script: String): JsonValue? {
        val res = this.browser.callPage(this, "page.evaluate", { rid ->
            scriptParams(rid, script)
        })
        if (res == null) {
            return null
        }
        return parseJson(res)
    }

    fun waitFor(selector: String, timeoutMs: Int = 30000): Bool {
        return this.waitForLocator(this.locator(selector), timeoutMs)
    }

    fun waitForLocator(loc: Locator, timeoutMs: Int = 30000): Bool {
        val res = this.browser.callPage(this, "page.waitFor", { rid ->
            locatorTimeoutParams(rid, loc, timeoutMs)
        })
        return res != null
    }

    fun waitForUrl(pattern: String, timeoutMs: Int = 30000): Bool {
        val res = this.browser.callPage(this, "page.waitForUrl", { rid ->
            patternParams(rid, pattern, timeoutMs)
        })
        return res != null
    }

    implement fun close(): Void {
        this.browser.closePage(this.id)
    }

    fun onRequest(handler: (ObservedRequest) -> Void): Bool {
        return this.browser.watchRequest(this, handler)
    }

    fun onResponse(handler: (ObservedResponse) -> Void): Bool {
        return this.browser.watchResponse(this, handler)
    }

    fun onConsole(handler: (ConsoleEvent) -> Void): Bool {
        return this.browser.watchConsole(this, handler)
    }

    fun onDownload(handler: (Download) -> Void): Bool {
        return this.browser.watchDownload(this, handler)
    }

    fun fireRequest(req: ObservedRequest): Bool {
        val h = this.reqHandler
        if (h == null) {
            return false
        }
        h(req)
        return true
    }

    fun fireResponse(res: ObservedResponse): Bool {
        val h = this.resHandler
        if (h == null) {
            return false
        }
        h(res)
        return true
    }

    fun fireConsole(ev: ConsoleEvent): Bool {
        val h = this.conHandler
        if (h == null) {
            return false
        }
        h(ev)
        return true
    }

    fun fireDownload(dl: Download): Bool {
        val h = this.dlHandler
        if (h == null) {
            return false
        }
        h(dl)
        return true
    }
}

fun subscribeParams(page: String, topic: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("page", jsonString(page))
    m.put("topic", jsonString(topic))
    return jsonObject(m.freeze()).write()
}
