// Worker accept loop: one TCP port serves WS + /health (§§30, 54).
//
// One task per connection; engine state serializes on its Mutex.
// `serve` answers stubs (initialize/version); `serveEngine` drives a
// live Chromium through the Engine.

import { Socket, TCPServer } from "std.net"
import { MutableList, MutableMap } from "std.collections"
import { StackTask } from "std.coroutines"
import { JsonValue, jsonObject, jsonString } from "std.json"
import { JsonRpc } from "std.jsonrpc"
import { wsRecv, buildFrame, writeAll } from ".browser.net.ws"
import { readHttpRequest, answerHandshake } from ".browser.net.ws_server"
import { parseFrame, isNotification, resultFrame, errorFrame } from ".browser.protocol.envelope"
import { BrowserError, timeoutError } from ".browser.protocol.errors"
import { dispatch, healthResponse } from ".browser.protocol.dispatch"
import { Engine } from ".browser.engine.engine"

fun routeOf(head: String): String {
    if (head.indexOf("Upgrade: websocket") >= 0) {
        return "ws"
    }
    if (head.indexOf("GET /health") == 0) {
        return "health"
    }
    return "bad"
}

fun serveFrames(sock: Socket): Void {
    serveFramesWith(sock, { raw -> dispatch(raw) })
}

fun serveFramesWith(sock: Socket, route: (String) -> String): Void {
    var open = true
    while (open) {
        val f = wsRecv(sock)
        if (f == null) {
            open = false
        } else if (f.opcode == 8) {
            writeAll(sock, buildFrame(8, "", null))
            open = false
        } else if (f.opcode == 9) {
            writeAll(sock, buildFrame(10, f.payload, null))
        } else if (f.opcode == 1 || f.opcode == 2) {
            val reply = route(f.payload)
            if (reply != "") {
                writeAll(sock, buildFrame(1, reply, null))
            }
        }
    }
    sock.close()
}

fun serveOne(sock: Socket, browsers: Int, contexts: Int): String {
    val head = readHttpRequest(sock)
    if (head == null) {
        sock.close()
        return "bad"
    }
    val route = routeOf(head)
    if (route == "health") {
        writeAll(sock, healthResponse(browsers, contexts))
        sock.close()
        return "health"
    }
    if (route == "ws") {
        if (answerHandshake(sock, head) == false) {
            return "bad"
        }
        serveFrames(sock)
        return "ws"
    }
    sock.close()
    return "bad"
}

fun serve(port: Int, maxConn: Int): Int {
    return serveLoop(port, maxConn, { sock -> serveOne(sock, 0, 0) })
}

fun serveEngine(port: Int, engine: Engine, maxConn: Int): Int {
    return serveLoop(port, maxConn, { sock -> serveOneEngine(sock, engine) })
}

fun serveLoop(port: Int, maxConn: Int, handle: (Socket) -> String): Int {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return -1
    }
    val jobs: MutableList<StackTask<String>> = MutableList<StackTask<String>>()
    var served = 0
    var idle = 0
    var stop = false
    while ((maxConn < 0 || served < maxConn) && stop == false) {
        val conn = server.accept()
        if (conn == null) {
            idle = idle + 1
            if (maxConn >= 0 && idle > 1200) {
                stop = true
            }
        } else {
            idle = 0
            val job = task {
                handle(conn)
            }
            jobs.add(job)
            served = served + 1
        }
    }
    server.close()
    var i = 0
    while (i < jobs.size()) {
        jobs.get(i).await()
        i = i + 1
    }
    return served
}

fun strResult(id: JsonValue, key: String, value: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put(key, jsonString(value))
    return resultFrame(id, jsonObject(m.freeze()).write())
}

fun okResult(id: JsonValue): String {
    return resultFrame(id, "{\"ok\": true}")
}

fun engineFailed(id: JsonValue, message: String): String {
    return errorFrame(id, BrowserError("ENGINE", message, false))
}

fun effTimeout(v: Int): Int {
    if (v <= 0) {
        return 30000
    }
    return v
}

fun locatorParam(rpc: JsonRpc, key: String): String {
    val loc = rpc.argument("locator")
    if (loc == null) {
        return ""
    }
    val v = loc!!.get(key)
    if (v == null || v!!.isString() == false) {
        return ""
    }
    return v!!.asString()
}

fun engineDispatch(engine: Engine, raw: String): String {
    if (isNotification(raw)) {
        return ""
    }
    val rpc = parseFrame(raw)
    if (rpc.method == "browser.newContext") {
        val ctx = engine.newContext()
        if (ctx == null) {
            return engineFailed(rpc.id, "no worker available")
        }
        return strResult(rpc.id, "context", ctx)
    }
    if (rpc.method == "context.newPage") {
        val page = engine.newPage(rpc.argumentString("context"))
        if (page == null) {
            return engineFailed(rpc.id, "unknown context")
        }
        return strResult(rpc.id, "page", page)
    }
    if (rpc.method == "page.goto") {
        if (engine.goto(rpc.argumentString("page"), rpc.argumentString("url"), effTimeout(rpc.argumentInt("timeoutMs")))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "navigation failed")
    }
    if (rpc.method == "page.reload") {
        if (engine.reload(rpc.argumentString("page"), effTimeout(rpc.argumentInt("timeoutMs")))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "reload failed")
    }
    if (rpc.method == "page.goBack") {
        if (engine.goBack(rpc.argumentString("page"), effTimeout(rpc.argumentInt("timeoutMs")))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "history travel failed")
    }
    if (rpc.method == "page.goForward") {
        if (engine.goForward(rpc.argumentString("page"), effTimeout(rpc.argumentInt("timeoutMs")))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "history travel failed")
    }
    if (rpc.method == "page.text") {
        val pageArg = rpc.argumentString("page")
        val locArg = rpc.argument("locator")
        var text: String? = null
        if (locArg != null) {
            val st = locArg!!.get("strategy")
            val se = locArg!!.get("selector")
            if (st != null && se != null && st!!.isString() && se!!.isString()) {
                text = engine.textByLocator(pageArg, st!!.asString(), se!!.asString())
            }
        } else {
            text = engine.text(pageArg)
        }
        if (text == null) {
            return engineFailed(rpc.id, "unknown page")
        }
        return strResult(rpc.id, "text", text!!)
    }
    if (rpc.method == "page.click") {
        if (engine.click(rpc.argumentString("page"), locatorParam(rpc, "strategy"), locatorParam(rpc, "selector"))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "click failed")
    }
    if (rpc.method == "page.fill") {
        if (engine.fill(rpc.argumentString("page"), locatorParam(rpc, "strategy"), locatorParam(rpc, "selector"), rpc.argumentString("value"))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "fill failed")
    }
    if (rpc.method == "page.typeText") {
        if (engine.typeText(rpc.argumentString("page"), locatorParam(rpc, "strategy"), locatorParam(rpc, "selector"), rpc.argumentString("value"))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "type failed")
    }
    if (rpc.method == "page.attribute") {
        val attr = engine.attribute(rpc.argumentString("page"), locatorParam(rpc, "strategy"), locatorParam(rpc, "selector"), rpc.argumentString("name"))
        if (attr == null) {
            return engineFailed(rpc.id, "unknown page")
        }
        return strResult(rpc.id, "value", attr)
    }
    if (rpc.method == "page.evaluate") {
        val out = engine.evaluate(rpc.argumentString("page"), rpc.argumentString("script"))
        if (out == null) {
            return engineFailed(rpc.id, "evaluation failed")
        }
        return resultFrame(rpc.id, out)
    }
    if (rpc.method == "page.waitFor") {
        if (engine.waitFor(rpc.argumentString("page"), locatorParam(rpc, "strategy"), locatorParam(rpc, "selector"), effTimeout(rpc.argumentInt("timeoutMs")))) {
            return okResult(rpc.id)
        }
        return errorFrame(rpc.id, timeoutError("wait timed out"))
    }
    if (rpc.method == "page.waitForUrl") {
        if (engine.waitForUrl(rpc.argumentString("page"), rpc.argumentString("pattern"), effTimeout(rpc.argumentInt("timeoutMs")))) {
            return okResult(rpc.id)
        }
        return errorFrame(rpc.id, timeoutError("wait timed out"))
    }
    if (rpc.method == "page.content") {
        val html = engine.content(rpc.argumentString("page"))
        if (html == null) {
            return engineFailed(rpc.id, "unknown page")
        }
        return strResult(rpc.id, "html", html)
    }
    if (rpc.method == "page.close") {
        if (engine.closePage(rpc.argumentString("page"))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "unknown page")
    }
    if (rpc.method == "context.close") {
        if (engine.closeContext(rpc.argumentString("context"))) {
            return okResult(rpc.id)
        }
        return engineFailed(rpc.id, "unknown context")
    }
    return dispatch(raw)
}

fun serveOneEngine(sock: Socket, engine: Engine): String {
    val head = readHttpRequest(sock)
    if (head == null) {
        sock.close()
        return "bad"
    }
    val route = routeOf(head)
    if (route == "health") {
        val contexts = engine.lock.withLock({ engine.contexts.count() })
        val pages = engine.lock.withLock({ engine.pages.count() })
        writeAll(sock, healthResponse(contexts, pages))
        sock.close()
        return "health"
    }
    if (route == "ws") {
        if (answerHandshake(sock, head) == false) {
            return "bad"
        }
        serveFramesWith(sock, { raw -> engineDispatch(engine, raw) })
        return "ws"
    }
    sock.close()
    return "bad"
}
