// Worker accept loop: one TCP port serves WS + /health (§§30, 54).
//
// Sequential per connection in MVP (task-per-connection is the
// production follow-up). Engine state (browser/context counts) wires in
// with the Chromium Adapter; currently reported as zero.

import { Socket, TCPServer } from "std.net"
import { MutableList } from "std.collections"
import { StackTask } from "std.coroutines"
import { wsRecv, buildFrame, writeAll } from ".browser.net.ws"
import { readHttpRequest, answerHandshake } from ".browser.net.ws_server"
import { dispatch, healthResponse } from ".browser.protocol.dispatch"

fun routeOf(head: String): String {
    if (head.indexOf("Upgrade: websocket") >= 0) {
        return "ws"
    }
    if (head.indexOf("GET /health") == 0) {
        return "health"
    }
    return "bad"
}

fun serveFrames(sock: Socket): Void {
    var open = true
    while (open) {
        val f = wsRecv(sock)
        if (f == null) {
            open = false
        } else if (f.opcode == 8) {
            writeAll(sock, buildFrame(8, "", null))
            open = false
        } else if (f.opcode == 9) {
            writeAll(sock, buildFrame(10, f.payload, null))
        } else if (f.opcode == 1 || f.opcode == 2) {
            val reply = dispatch(f.payload)
            if (reply != "") {
                writeAll(sock, buildFrame(1, reply, null))
            }
        }
    }
    sock.close()
}

fun serveOne(sock: Socket, browsers: Int, contexts: Int): String {
    val head = readHttpRequest(sock)
    if (head == null) {
        sock.close()
        return "bad"
    }
    val route = routeOf(head)
    if (route == "health") {
        writeAll(sock, healthResponse(browsers, contexts))
        sock.close()
        return "health"
    }
    if (route == "ws") {
        if (answerHandshake(sock, head) == false) {
            return "bad"
        }
        serveFrames(sock)
        return "ws"
    }
    sock.close()
    return "bad"
}

fun serve(port: Int, maxConn: Int): Int {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return -1
    }
    val jobs: MutableList<StackTask<String>> = MutableList<StackTask<String>>()
    var served = 0
    var idle = 0
    var stop = false
    // One task per connection; shared engine state must go behind a
    // Mutex once browsers/contexts stop being hardcoded below.
    while ((maxConn < 0 || served < maxConn) && stop == false) {
        val conn = server.accept()
        if (conn == null) {
            idle = idle + 1
            if (maxConn >= 0 && idle > 1200) {
                stop = true
            }
        } else {
            idle = 0
            val job = task {
                serveOne(conn, 0, 0)
            }
            jobs.add(job)
            served = served + 1
        }
    }
    server.close()
    var i = 0
    while (i < jobs.size()) {
        jobs.get(i).await()
        i = i + 1
    }
    return served
}
