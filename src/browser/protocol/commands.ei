// Typed JSON-RPC command builders (MVP surface in §45).
//
// Single place where method names and params are defined; `requestFrame`
// does the envelope. Builders return null on invalid input instead of
// emitting a malformed frame.

import { MutableMap } from "std.collections"
import { JsonValue, jsonObject, jsonString, jsonNumber } from "std.json"
import { requestFrame } from ".browser.protocol.envelope"
import { Locator, locatorValue } from ".browser.locator.locator"

fun validWaitUntil(v: String): Bool {
    return v == "commit" || v == "domcontentloaded" || v == "load" || v == "networkidle"
}

fun gotoCmd(id: Int, page: String, url: String, waitUntil: String, timeoutMs: Int): String? {
    if (page == "" || url == "") {
        return null
    }
    if (validWaitUntil(waitUntil) == false) {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("page", jsonString(page))
    params.put("url", jsonString(url))
    params.put("waitUntil", jsonString(waitUntil))
    params.put("timeoutMs", jsonNumber(timeoutMs.toDouble()))
    return requestFrame(id, "page.goto", jsonObject(params.freeze()).write())
}

