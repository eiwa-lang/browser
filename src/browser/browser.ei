// Browser client handle (§§5.2, 6.1).
//
// Owns the worker pool, the proxy registry, id counters, sticky
// context→worker pins and one persistent WebSocket per worker.
// Event callbacks fire on `poll()` (explicit) and around commands.

import { MutableList, MutableMap } from "std.collections"
import { Closeable } from "std.core"
import { parseJson } from "std.json"
import { WorkerPool } from ".browser.pool"
import { TimeoutConfig, resolveTimeout } from ".browser.timeouts"
import { Timeout, Cancelled, ChallengeDetected, WorkerClosed, ResourceExhausted, UnknownBrowserError } from ".browser.protocol.errors"
import { ProxyRegistry } from ".browser.protocol.registry"
import { Subscriptions } from ".browser.protocol.subscriptions"
import { PluginRegistry } from ".browser.plugins.plugins"
import { ObservedRequest, ObservedResponse, parseRequest, parseResponse } from ".browser.network.network"
import { ConsoleEvent, parseConsole } from ".browser.challenge.challenge"
import { Download, parseDownload } from ".browser.storage.state"
import { WorkerClient, workerConnect } from ".browser.client"
import { BrowserContext } from ".context.context"
import { Page, subscribeParams } from ".page.page"

type NoWorkerAvailable(val detail: String) : Throwable {
    implement fun message(): String {
        return this.detail
    }
}

type UnknownContext(val context: String) : Throwable {
    implement fun message(): String {
        return "unknown context: " + this.context
    }
}

type Browser(
    val workers: List<String> = ["ws://localhost:8080"],
    val poolSize: Int = 1,
    val headless: Bool = true
) : Closeable {
    val pool: WorkerPool = WorkerPool(workers)
    val registry: ProxyRegistry = ProxyRegistry()
    val pinned: MutableMap<String, String> = MutableMap<String, String>()
    val clients: MutableMap<String, WorkerClient> = MutableMap<String, WorkerClient>()
    val remoteCtx: MutableMap<String, String> = MutableMap<String, String>()
    val remotePage: MutableMap<String, String> = MutableMap<String, String>()
    val subs: Subscriptions = Subscriptions()
    val tracked: MutableMap<String, Page> = MutableMap<String, Page>()
    val plugins: PluginRegistry = PluginRegistry()
    val timeouts: TimeoutConfig = TimeoutConfig()
    val scopedTimeouts: MutableMap<String, TimeoutConfig> = MutableMap<String, TimeoutConfig>()
    var nextContext: Int = 1
    var nextPage: Int = 1

    fun setTimeout(category: String, ms: Int): Void {
        this.timeouts.set(category, ms)
    }

    fun setScopeTimeout(id: String, category: String, ms: Int): Void {
        val known = this.scopedTimeouts.get(id)
        if (known != null) {
            known.set(category, ms)
            return
        }
        val cfg = TimeoutConfig()
        cfg.set(category, ms)
        this.scopedTimeouts.put(id, cfg)
    }

    // Operation timeout wins when positive; otherwise the most
    // specific scope wins (page, context, browser), else the builtin
    // default. Scopes live on the browser keyed by handle id, so they
    // survive re-listing pages and contexts.
    fun effTimeout(page: Page, category: String, opMs: Int): Int {
        if (opMs > 0) {
            return opMs
        }
        val scopes: MutableList<TimeoutConfig> = MutableList<TimeoutConfig>()
        val pageCfg = this.scopedTimeouts.get(page.id)
        if (pageCfg != null) {
            scopes.add(pageCfg)
        }
        val ctxCfg = this.scopedTimeouts.get(page.context)
        if (ctxCfg != null) {
            scopes.add(ctxCfg)
        }
        scopes.add(this.timeouts)
        return resolveTimeout(category, scopes.freeze())
    }

    fun newContext(storageState: String? = null): BrowserContext {
        if (this.headless == false) {
            return throw NoWorkerAvailable("headed browsers have no display in MVP")
        }
        val url = this.pool.pick()
        if (url == null) {
            return throw NoWorkerAvailable("no worker available")
        }
        val id = "ctx-${this.nextContext}"
        this.nextContext = this.nextContext + 1
        this.pinned.put(id, url)
        if (this.registry.register(id, "browser")) {
            val ctx = BrowserContext(this, id)
            ctx.applyState(storageState)
            return ctx
        }
        this.pinned.remove(id)
        return throw NoWorkerAvailable("context registry refused")
    }

    fun contexts(): List<BrowserContext> {
        val out: MutableList<BrowserContext> = MutableList<BrowserContext>()
        val pinned = this.pinned
        for (pinned) { entry ->
            out.add(BrowserContext(this, entry.key))
        }
        return out.freeze()
    }

    fun workerOf(ctx: String): String? {
        return this.pinned.get(ctx)
    }

    fun newPage(ctx: BrowserContext? = null): Page {
        val c: BrowserContext = if (ctx == null) { this.newContext() } else { ctx }
        if (this.pinned.contains(c.id) == false) {
            return throw UnknownContext(c.id)
        }
        val id = "page-${this.nextPage}"
        this.nextPage = this.nextPage + 1
        if (this.registry.register(id, c.id)) {
            val page = Page(this, id, c.id)
            this.tracked.put(id, page)
            return page
        }
        // Unreachable with minted ids (register only rejects malformed
        // ones); typed as provisioning failure.
        return throw NoWorkerAvailable("page registry refused")
    }

    fun pages(ctx: BrowserContext): List<Page> {
        val out: MutableList<Page> = MutableList<Page>()
        val ids = this.registry.childrenOf(ctx.id)
        var i = 0
        while (i < ids.size()) {
            val known = this.tracked.get(ids.get(i))
            if (known != null) {
                out.add(known)
            } else {
                val fresh = Page(this, ids.get(i), ctx.id)
                this.tracked.put(ids.get(i), fresh)
                out.add(fresh)
            }
            i = i + 1
        }
        return out.freeze()
    }

    fun closePage(id: String): Bool {
        val known = this.tracked.get(id)
        if (known != null) {
            val rid = this.remotePage.get(id)
            if (rid != null) {
                this.sendRemote(known.context, "page.close", "{\"page\": \"$rid\"}")
            }
        }
        this.tracked.remove(id)
        this.subs.dropPage(id)
        return this.registry.remove(id)
    }

    fun closeContext(id: String): Bool {
        val kids = this.registry.childrenOf(id)
        var i = 0
        while (i < kids.size()) {
            val rid = this.remotePage.get(kids.get(i))
            if (rid != null) {
                this.sendRemote(id, "page.close", "{\"page\": \"$rid\"}")
            }
            this.remotePage.remove(kids.get(i))
            this.tracked.remove(kids.get(i))
            this.subs.dropPage(kids.get(i))
            i = i + 1
        }
        val rctx = this.remoteCtx.get(id)
        if (rctx != null) {
            this.sendRemote(id, "context.close", "{\"context\": \"$rctx\"}")
        }
        this.remoteCtx.remove(id)
        val unpinned = this.pinned.remove(id) != null
        val dropped = this.registry.remove(id)
        return unpinned || dropped
    }

    // Transport: one persistent WorkerClient per worker URL, connected
    // lazily on first command. Routing (newContext/newPage) stays
    // socket-free; ids minted locally map to worker ids on provision.
    fun clientFor(url: String): WorkerClient? {
        val known = this.clients.get(url)
        if (known != null) {
            return known
        }
        val fresh = workerConnect(url)
        if (fresh == null) {
            this.pool.markDead(url)
            return null
        }
        this.clients.put(url, fresh)
        return fresh
    }

    fun provisionCtx(local: String): String? {
        val known = this.remoteCtx.get(local)
        if (known != null) {
            return known
        }
        val url = this.pinned.get(local)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call("browser.newContext", "{}")
        if (res == null) {
            if (client.ws.closed) {
                this.pool.markDead(url)
            }
            return null
        }
        val idVal = parseJson(res).get("context")
        if (idVal == null || idVal!!.isString() == false) {
            return null
        }
        this.remoteCtx.put(local, idVal!!.asString())
        return idVal!!.asString()
    }

    fun provisionPage(page: Page): String? {
        val known = this.remotePage.get(page.id)
        if (known != null) {
            return known
        }
        val rctx = this.provisionCtx(page.context)
        if (rctx == null) {
            return null
        }
        val url = this.pinned.get(page.context)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call("context.newPage", "{\"context\": \"$rctx\"}")
        if (res == null) {
            if (client.ws.closed) {
                this.pool.markDead(url)
            }
            return null
        }
        val idVal = parseJson(res).get("page")
        if (idVal == null || idVal!!.isString() == false) {
            return null
        }
        this.remotePage.put(page.id, idVal!!.asString())
        return idVal!!.asString()
    }

    fun callPage(page: Page, method: String, makeParams: (String) -> String, timeoutMs: Int = 30000): String? {
        val rid = this.provisionPage(page)
        if (rid == null) {
            return null
        }
        val url = this.pinned.get(page.context)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call(method, makeParams(rid), timeoutMs)
        if (res == null && client.ws.closed) {
            this.pool.markDead(url)
        }
        return res
    }

    fun callContext(ctx: BrowserContext, method: String, makeParams: (String) -> String, timeoutMs: Int = 30000): String? {
        val rid = this.provisionCtx(ctx.id)
        if (rid == null) {
            return null
        }
        val url = this.pinned.get(ctx.id)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call(method, makeParams(rid), timeoutMs)
        if (res == null && client.ws.closed) {
            this.pool.markDead(url)
        }
        return res
    }

    fun callDownload(ctx: String, method: String, params: String): String? {
        val url = this.pinned.get(ctx)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call(method, params)
        if (res == null && client.ws.closed) {
            this.pool.markDead(url)
        }
        return res
    }

    fun localPage(remote: String): String? {
        for (this.remotePage) { entry ->
            if (entry.value == remote) {
                return entry.key
            }
        }
        return null
    }

    fun version(): String? {
        var i = 0
        while (i < this.workers.size()) {
            val client = this.clientFor(this.workers.get(i))
            if (client != null) {
                return client.version()
            }
            i = i + 1
        }
        return null
    }

    fun isConnected(): Bool {
        for (this.clients) { entry ->
            if (entry.value.ws.closed == false) {
                return true
            }
        }
        return false
    }

    // Best-effort remote send for teardown: failures mean the worker is
    // already gone, so errors are swallowed and local state drops anyway.
    fun sendRemote(ctx: String, method: String, params: String): Void {
        val url = this.pinned.get(ctx)
        if (url == null) {
            return
        }
        val client = this.clientFor(url)
        if (client == null) {
            return
        }
        try {
            client.call(method, params)
        } catch (e: Timeout | Cancelled | ChallengeDetected | WorkerClosed | ResourceExhausted | UnknownBrowserError) {
        }
    }

    fun subscribePage(page: Page, topic: String): Bool {
        if (this.subs.subscribe(page.id, topic) == false) {
            return true
        }
        val res = this.callPage(page, "page.subscribe", { rid ->
            subscribeParams(rid, topic)
        })
        if (res == null) {
            this.subs.unsubscribe(page.id, topic)
            return false
        }
        return true
    }

    fun watchRequest(page: Page, handler: (ObservedRequest) -> Void): Bool {
        if (this.subscribePage(page, "request") == false) {
            return false
        }
        page.reqHandler = handler
        return true
    }

    fun watchResponse(page: Page, handler: (ObservedResponse) -> Void): Bool {
        if (this.subscribePage(page, "response") == false) {
            return false
        }
        page.resHandler = handler
        return true
    }

    fun watchConsole(page: Page, handler: (ConsoleEvent) -> Void): Bool {
        if (this.subscribePage(page, "console") == false) {
            return false
        }
        page.conHandler = handler
        return true
    }

    fun watchDownload(page: Page, handler: (Download) -> Void): Bool {
        if (this.subscribePage(page, "download") == false) {
            return false
        }
        page.dlHandler = handler
        return true
    }

    fun use(name: String, topics: List<String>): Bool {
        if (this.plugins.use(name, topics) == false) {
            return false
        }
        var i = 0
        while (i < topics.size()) {
            this.subscribeAll(topics.get(i))
            i = i + 1
        }
        return true
    }

    fun unuse(name: String): Bool {
        return this.plugins.unuse(name)
    }

    fun subscribed(name: String, topic: String): Bool {
        return this.plugins.subscribed(name, topic)
    }

    fun subscribeAll(topic: String): Void {
        val ctxs = this.contexts()
        var i = 0
        while (i < ctxs.size()) {
            val pages = ctxs.get(i).pages()
            var j = 0
            while (j < pages.size()) {
                this.subscribePage(pages.get(j), topic)
                j = j + 1
            }
            i = i + 1
        }
    }

    fun poll(timeoutMs: Int = 2000): Int {
        var delivered = 0
        for (this.clients) { entry ->
            delivered = delivered + this.dispatchAll(entry.value.drainEvents())
            delivered = delivered + this.dispatchAll(entry.value.poll(timeoutMs))
        }
        return delivered
    }

    fun dispatchAll(notes: List<String>): Int {
        var n = 0
        var i = 0
        while (i < notes.size()) {
            if (this.dispatchOne(notes.get(i))) {
                n = n + 1
            }
            i = i + 1
        }
        return n
    }

    fun dispatchOne(raw: String): Bool {
        val msg = parseJson(raw)
        val methodVal = msg.get("method")
        if (methodVal == null || methodVal!!.isString() == false) {
            return false
        }
        val method = methodVal!!.asString()
        val params = msg.get("params")
        if (params == null) {
            return false
        }
        val pageVal = params!!.get("page")
        if (pageVal == null || pageVal!!.isString() == false) {
            return false
        }
        val local = this.localPage(pageVal!!.asString())
        if (local == null) {
            return false
        }
        val page = this.tracked.get(local)
        if (page == null) {
            return false
        }
        if (method == "page.request") {
            val req = parseRequest(params)
            if (req == null) {
                return false
            }
            return page.fireRequest(req)
        }
        if (method == "page.response") {
            val res = parseResponse(params)
            if (res == null) {
                return false
            }
            return page.fireResponse(res)
        }
        if (method == "page.console") {
            val ev = parseConsole(params)
            if (ev == null) {
                return false
            }
            return page.fireConsole(ev)
        }
        if (method == "page.download") {
            val dl = parseDownload(this, page.context, page.id, params)
            if (dl == null) {
                return false
            }
            return page.fireDownload(dl)
        }
        return false
    }

    implement fun close(): Void {
        val live = this.contexts()
        var i = 0
        while (i < live.size()) {
            this.closeContext(live.get(i).id)
            i = i + 1
        }
        for (this.clients) { entry ->
            entry.value.close()
        }
    }
}
