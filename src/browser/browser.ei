// Browser client handle (§§5.2, 6.1).
//
// Owns the worker pool, the proxy registry, id counters and sticky
// context→worker pins. Transport (real WebSockets) attaches later;
// routing decisions are fully testable here.

import { MutableList, MutableMap } from "std.collections"
import { Closeable } from "std.core"
import { parseJson } from "std.json"
import { WorkerPool } from ".browser.pool"
import { ProxyRegistry } from ".browser.protocol.registry"
import { WorkerClient, workerConnect } from ".browser.client"
import { BrowserContext } from ".context.context"
import { Page } from ".page.page"

type NoWorkerAvailable(val detail: String) : Throwable {
    implement fun message(): String {
        return this.detail
    }
}

type UnknownContext(val context: String) : Throwable {
    implement fun message(): String {
        return "unknown context: " + this.context
    }
}

type Browser(
    val workers: List<String> = ["ws://localhost:8080"],
    val poolSize: Int = 1,
    val headless: Bool = true
) : Closeable {
    val pool: WorkerPool = WorkerPool(workers)
    val registry: ProxyRegistry = ProxyRegistry()
    val pinned: MutableMap<String, String> = MutableMap<String, String>()
    val clients: MutableMap<String, WorkerClient> = MutableMap<String, WorkerClient>()
    val remoteCtx: MutableMap<String, String> = MutableMap<String, String>()
    val remotePage: MutableMap<String, String> = MutableMap<String, String>()
    var nextContext: Int = 1
    var nextPage: Int = 1

    fun newContext(): BrowserContext {
        if (this.headless == false) {
            return throw NoWorkerAvailable("headed browsers have no display in MVP")
        }
        val url = this.pool.pick()
        if (url == null) {
            return throw NoWorkerAvailable("no worker available")
        }
        val id = "ctx-${this.nextContext}"
        this.nextContext = this.nextContext + 1
        this.pinned.put(id, url)
        if (this.registry.register(id, "browser")) {
            return BrowserContext(this, id)
        }
        this.pinned.remove(id)
        return throw NoWorkerAvailable("context registry refused")
    }

    fun contexts(): List<BrowserContext> {
        val out: MutableList<BrowserContext> = MutableList<BrowserContext>()
        val pinned = this.pinned
        for (pinned) { entry ->
            out.add(BrowserContext(this, entry.key))
        }
        return out.freeze()
    }

    fun workerOf(ctx: String): String? {
        return this.pinned.get(ctx)
    }

    fun newPage(ctx: BrowserContext? = null): Page {
        val c: BrowserContext = if (ctx == null) { this.newContext() } else { ctx }
        if (this.pinned.contains(c.id) == false) {
            return throw UnknownContext(c.id)
        }
        val id = "page-${this.nextPage}"
        this.nextPage = this.nextPage + 1
        if (this.registry.register(id, c.id)) {
            return Page(this, id, c.id)
        }
        // Unreachable with minted ids (register only rejects malformed
        // ones); typed as provisioning failure.
        return throw NoWorkerAvailable("page registry refused")
    }

    fun pages(ctx: BrowserContext): List<Page> {
        val out: MutableList<Page> = MutableList<Page>()
        val ids = this.registry.childrenOf(ctx.id)
        var i = 0
        while (i < ids.size()) {
            out.add(Page(this, ids.get(i), ctx.id))
            i = i + 1
        }
        return out.freeze()
    }

    fun closePage(id: String): Bool {
        return this.registry.remove(id)
    }

    fun closeContext(id: String): Bool {
        val kids = this.registry.childrenOf(id)
        var i = 0
        while (i < kids.size()) {
            this.remotePage.remove(kids.get(i))
            i = i + 1
        }
        this.remoteCtx.remove(id)
        val unpinned = this.pinned.remove(id) != null
        val dropped = this.registry.remove(id)
        return unpinned || dropped
    }

    // Transport: one persistent WorkerClient per worker URL, connected
    // lazily on first command. Routing (newContext/newPage) stays
    // socket-free; ids minted locally map to worker ids on provision.
    fun clientFor(url: String): WorkerClient? {
        val known = this.clients.get(url)
        if (known != null) {
            return known
        }
        val fresh = workerConnect(url)
        if (fresh == null) {
            this.pool.markDead(url)
            return null
        }
        this.clients.put(url, fresh)
        return fresh
    }

    fun provisionCtx(local: String): String? {
        val known = this.remoteCtx.get(local)
        if (known != null) {
            return known
        }
        val url = this.pinned.get(local)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call("browser.newContext", "{}")
        if (res == null) {
            if (client.ws.closed) {
                this.pool.markDead(url)
            }
            return null
        }
        val idVal = parseJson(res).get("context")
        if (idVal == null || idVal!!.isString() == false) {
            return null
        }
        this.remoteCtx.put(local, idVal!!.asString())
        return idVal!!.asString()
    }

    fun provisionPage(page: Page): String? {
        val known = this.remotePage.get(page.id)
        if (known != null) {
            return known
        }
        val rctx = this.provisionCtx(page.context)
        if (rctx == null) {
            return null
        }
        val url = this.pinned.get(page.context)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call("context.newPage", "{\"context\": \"$rctx\"}")
        if (res == null) {
            if (client.ws.closed) {
                this.pool.markDead(url)
            }
            return null
        }
        val idVal = parseJson(res).get("page")
        if (idVal == null || idVal!!.isString() == false) {
            return null
        }
        this.remotePage.put(page.id, idVal!!.asString())
        return idVal!!.asString()
    }

    fun callPage(page: Page, method: String, makeParams: (String) -> String): String? {
        val rid = this.provisionPage(page)
        if (rid == null) {
            return null
        }
        val url = this.pinned.get(page.context)
        if (url == null) {
            return null
        }
        val client = this.clientFor(url)
        if (client == null) {
            return null
        }
        val res = client.call(method, makeParams(rid))
        if (res == null && client.ws.closed) {
            this.pool.markDead(url)
        }
        return res
    }

    implement fun close(): Void {
        val live = this.contexts()
        var i = 0
        while (i < live.size()) {
            this.closeContext(live.get(i).id)
            i = i + 1
        }
        for (this.clients) { entry ->
            entry.value.close()
        }
    }
}
