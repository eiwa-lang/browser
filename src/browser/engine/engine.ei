// Engine: live browser automation over one DevTools connection (§§5.4, 5.5).
//
// Public methods take the lock; inner helpers assume it is held (never
// nest). Managers own ids, the adapter (CdpConn) owns the wire.

import { Mutex } from "std.thread"
import { sleepMs, nowMillis } from "std.time"
import { JsonValue, jsonObject, jsonString, jsonNumber, jsonArray, parseJson } from "std.json"
import { List, MutableList, MutableMap } from "std.collections"
import { Env } from "std.env"
import { File } from "std.fs"
import { Encoding } from "crypto.encoding"
import { notifyFrame } from ".browser.protocol.envelope"
import { Subscriptions } from ".browser.protocol.subscriptions"
import { Chromium } from ".browser.chromium.chromium"
import { CdpConn, awaitEvent } from ".browser.chromium.connection"
import { ContextManager, PageManager } from ".browser.engine.managers"
import { createBrowserContextCmd, createTargetCtxCmd, disposeBrowserContextCmd, attachCmd, navigateCmd, evaluateCmd, closeTargetCmd, sessionCmd, historyEntryCmd, parseHistoryEntry, locatorTextScript, locatorClickScript, locatorFillScript, locatorTypeScript, locatorAttrScript, locatorFocusScript, inputInsertCmd, inputKeyCmd, vkFor, storageCookiesCmd, storageSetCmd, storageClearCmd, parseStorageCookies, downloadBehaviorCmd, parseBrowserContextCreated, parseTargetCreated, parseAttached, parseNavigateFrame, evaluateValue, cdpEventMethod, cdpSessionOf } from ".browser.chromium.cdp_commands"
import { Cookie, cookieValue } from ".browser.storage.cookies"

fun systemTempDir(): String {
    val tmpdir = Env.get("TMPDIR")
    if (tmpdir != null) {
        return tmpdir
    }
    val temp = Env.get("TEMP")
    if (temp != null) {
        return temp
    }
    val tmp = Env.get("TMP")
    if (tmp != null) {
        return tmp
    }
    return "/tmp"
}

fun guessMime(fileName: String): String {
    if (fileName.indexOf(".pdf") >= 0) {
        return "application/pdf"
    }
    if (fileName.indexOf(".zip") >= 0) {
        return "application/zip"
    }
    if (fileName.indexOf(".png") >= 0) {
        return "image/png"
    }
    if (fileName.indexOf(".jpg") >= 0 || fileName.indexOf(".jpeg") >= 0) {
        return "image/jpeg"
    }
    if (fileName.indexOf(".csv") >= 0) {
        return "text/csv"
    }
    if (fileName.indexOf(".txt") >= 0) {
        return "text/plain"
    }
    return "application/octet-stream"
}

type DownloadState(val path: String, val page: String, val fileName: String, val mime: String, val size: Int)

type Engine(
    val chromium: Chromium,
    val conn: CdpConn,
    val contexts: ContextManager = ContextManager(),
    val pages: PageManager = PageManager(),
    val lock: Mutex = Mutex(),
    val subs: Subscriptions = Subscriptions(),
    val downloads: MutableMap<String, DownloadState> = MutableMap<String, DownloadState>(),
    val armedDownloads: MutableList<String> = MutableList<String>(),
    var downloadDir: String = systemTempDir()
) {

    fun newContext(): String? {
        val out = this.lock.withLock({ this.createContext() })
        return out
    }

    fun createContext(): String? {
        val id = this.contexts.create()
        val raw = this.conn.call({ callId -> createBrowserContextCmd(callId) }, 10000)
        if (raw == null) {
            this.contexts.drop(id)
            return null
        }
        val cdpId = parseBrowserContextCreated(parseJson(raw))
        if (cdpId == null) {
            this.contexts.drop(id)
            return null
        }
        if (this.contexts.bind(id, cdpId) == false) {
            this.contexts.drop(id)
            return null
        }
        return id
    }

    fun newPage(ctx: String): String? {
        val out = this.lock.withLock({ this.createPage(ctx) })
        return out
    }

    fun createPage(ctx: String): String? {
        val cdpCtx = this.contexts.cdpId(ctx)
        if (cdpCtx == null) {
            return null
        }
        val id = this.pages.create(ctx)
        val created = this.conn.call({ callId -> createTargetCtxCmd(callId, "about:blank", cdpCtx) }, 10000)
        if (created == null) {
            this.pages.drop(id)
            return null
        }
        val target = parseTargetCreated(parseJson(created))
        if (target == null) {
            this.pages.drop(id)
            return null
        }
        val attached = this.conn.call({ callId -> attachCmd(callId, target) }, 10000)
        if (attached == null) {
            this.pages.drop(id)
            return null
        }
        val session = parseAttached(parseJson(attached))
        if (session == null) {
            this.pages.drop(id)
            return null
        }
        if (this.pages.bind(id, target, session.session) == false) {
            this.pages.drop(id)
            return null
        }
        return id
    }

    fun goto(page: String, url: String, timeoutMs: Int): Bool {
        val out = this.lock.withLock({ this.navigate(page, url, timeoutMs) })
        return out
    }

    fun navigate(page: String, url: String, timeoutMs: Int): Bool {
        val binding = this.pages.binding(page)
        if (binding == null || url == "") {
            return false
        }
        val session = binding.session
        val enabled = this.conn.call({ callId -> sessionCmd(callId, session, "Page.enable") }, 10000)
        if (enabled == null) {
            return false
        }
        val navigated = this.conn.call({ callId -> navigateCmd(callId, session, url) }, 10000)
        if (navigated == null) {
            return false
        }
        val frame = parseNavigateFrame(parseJson(navigated))
        if (frame != null) {
            this.pages.noteFrame(page, frame)
        }
        return this.awaitLoad(session, timeoutMs)
    }

    fun awaitLoad(session: String, timeoutMs: Int): Bool {
        return awaitEvent(this.conn, { raw -> cdpEventMethod(parseJson(raw)) == "Page.loadEventFired" && cdpSessionOf(parseJson(raw)) == session }, timeoutMs)
    }

    fun reload(page: String, timeoutMs: Int): Bool {
        val out = this.lock.withLock({ this.reloadPage(page, timeoutMs) })
        return out
    }

    fun reloadPage(page: String, timeoutMs: Int): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        val reloaded = this.conn.call({ callId -> sessionCmd(callId, binding.session, "Page.reload") }, 10000)
        if (reloaded == null) {
            return false
        }
        return this.awaitLoad(binding.session, timeoutMs)
    }

    fun goBack(page: String, timeoutMs: Int): Bool {
        val out = this.lock.withLock({ this.travel(page, -1, timeoutMs) })
        return out
    }

    fun goForward(page: String, timeoutMs: Int): Bool {
        val out = this.lock.withLock({ this.travel(page, 1, timeoutMs) })
        return out
    }

    fun travel(page: String, delta: Int, timeoutMs: Int): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        val session = binding.session
        val raw = this.conn.call({ callId -> sessionCmd(callId, session, "Page.getNavigationHistory") }, 10000)
        if (raw == null) {
            return false
        }
        val entry = parseHistoryEntry(parseJson(raw), delta)
        if (entry == null) {
            return false
        }
        val target = entry!!
        val gone = this.conn.call({ callId -> historyEntryCmd(callId, session, target) }, 10000)
        if (gone == null) {
            return false
        }
        return this.awaitLoad(session, timeoutMs)
    }

    fun text(page: String): String? {
        val out = this.lock.withLock({ this.readText(page) })
        return out
    }

    fun readText(page: String): String? {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return null
        }
        return this.readScript(binding.session, "document.body.innerText")
    }

    fun content(page: String): String? {
        val out = this.lock.withLock({ this.readContent(page) })
        return out
    }

    fun readContent(page: String): String? {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return null
        }
        return this.readScript(binding.session, "document.documentElement.outerHTML")
    }

    fun readScript(session: String, script: String): String? {
        val raw = this.conn.call({ callId -> evaluateCmd(callId, session, script) }, 10000)
        if (raw == null) {
            return null
        }
        val value = evaluateValue(parseJson(raw))
        if (value == null || value!!.isString() == false) {
            return null
        }
        return value!!.asString()
    }

    fun textByLocator(page: String, strategy: String, selector: String): String? {
        val out = this.lock.withLock({ this.readLocatorText(page, strategy, selector) })
        return out
    }

    fun readLocatorText(page: String, strategy: String, selector: String): String? {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return null
        }
        val script = locatorTextScript(strategy, selector)
        if (script == null) {
            return null
        }
        return this.readScript(binding.session, script)
    }

    fun click(page: String, strategy: String, selector: String): Bool {
        val out = this.lock.withLock({ this.clickLocator(page, strategy, selector) })
        return out
    }

    fun clickLocator(page: String, strategy: String, selector: String): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        val script = locatorClickScript(strategy, selector)
        if (script == null) {
            return false
        }
        val r = this.readScript(binding.session, script)
        return r != null && r == "ok"
    }

    fun fill(page: String, strategy: String, selector: String, value: String): Bool {
        val out = this.lock.withLock({ this.fillLocator(page, strategy, selector, value) })
        return out
    }

    fun fillLocator(page: String, strategy: String, selector: String, value: String): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        val script = locatorFillScript(strategy, selector, value)
        if (script == null) {
            return false
        }
        val r = this.readScript(binding.session, script)
        return r != null && r == "ok"
    }

    fun typeText(page: String, strategy: String, selector: String, value: String): Bool {
        val out = this.lock.withLock({ this.typeLocator(page, strategy, selector, value) })
        return out
    }

    fun typeLocator(page: String, strategy: String, selector: String, value: String): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        val script = locatorTypeScript(strategy, selector, value)
        if (script == null) {
            return false
        }
        val r = this.readScript(binding.session, script)
        return r != null && r == "ok"
    }

    fun attribute(page: String, strategy: String, selector: String, name: String): String? {
        val out = this.lock.withLock({ this.readAttribute(page, strategy, selector, name) })
        return out
    }

    fun readAttribute(page: String, strategy: String, selector: String, name: String): String? {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return null
        }
        val script = locatorAttrScript(strategy, selector, name)
        if (script == null) {
            return null
        }
        return this.readScript(binding.session, script)
    }

    fun press(page: String, strategy: String, selector: String, key: String): Bool {
        val out = this.lock.withLock({ this.pressKey(page, strategy, selector, key) })
        return out
    }

    fun pressKey(page: String, strategy: String, selector: String, key: String): Bool {
        val binding = this.pages.binding(page)
        if (binding == null || key == "") {
            return false
        }
        val session = binding.session
        val focus = locatorFocusScript(strategy, selector)
        if (focus == null) {
            return false
        }
        val focused = this.readScript(session, focus)
        if (focused == null || focused != "ok") {
            return false
        }
        if (key.length == 1) {
            return this.conn.call({ callId -> inputInsertCmd(callId, session, key) }, 10000) != null
        }
        val vk = vkFor(key)
        if (vk == 0) {
            return false
        }
        val down = this.conn.call({ callId -> inputKeyCmd(callId, session, "keyDown", key, key, vk) }, 10000)
        if (down == null) {
            return false
        }
        return this.conn.call({ callId -> inputKeyCmd(callId, session, "keyUp", key, key, vk) }, 10000) != null
    }

    fun evaluate(page: String, script: String): String? {
        val out = this.lock.withLock({ this.evalRaw(page, script) })
        return out
    }

    fun evalRaw(page: String, script: String): String? {
        val binding = this.pages.binding(page)
        if (binding == null || script == "") {
            return null
        }
        val raw = this.conn.call({ callId -> evaluateCmd(callId, binding.session, script) }, 10000)
        if (raw == null) {
            return null
        }
        val value = evaluateValue(parseJson(raw))
        if (value == null) {
            return null
        }
        return value!!.write()
    }

    fun waitFor(page: String, strategy: String, selector: String, timeoutMs: Int): Bool {
        val out = this.lock.withLock({ this.pollLocator(page, strategy, selector, timeoutMs) })
        return out
    }

    fun pollLocator(page: String, strategy: String, selector: String, timeoutMs: Int): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        val script = locatorWaitScript(strategy, selector)
        if (script == null) {
            return false
        }
        val code = script
        val session = binding.session
        val start = nowMillis()
        while (nowMillis() - start < timeoutMs) {
            val budget = timeoutMs - (nowMillis() - start)
            val raw = this.conn.call({ callId -> evaluateCmd(callId, session, code) }, budget)
            if (raw != null) {
                val value = evaluateValue(parseJson(raw))
                if (value != null && value!!.isString() && value!!.asString() == "found") {
                    return true
                }
            }
            sleepMs(100)
        }
        return false
    }

    fun waitForUrl(page: String, pattern: String, timeoutMs: Int): Bool {
        val out = this.lock.withLock({ this.pollUrl(page, pattern, timeoutMs) })
        return out
    }

    fun pollUrl(page: String, pattern: String, timeoutMs: Int): Bool {
        val binding = this.pages.binding(page)
        if (binding == null || pattern == "") {
            return false
        }
        val session = binding.session
        val start = nowMillis()
        while (nowMillis() - start < timeoutMs) {
            val budget = timeoutMs - (nowMillis() - start)
            val raw = this.conn.call({ callId -> evaluateCmd(callId, session, "window.location.href") }, budget)
            if (raw != null) {
                val value = evaluateValue(parseJson(raw))
                if (value != null && value!!.isString() && matchGlob(pattern, value!!.asString())) {
                    return true
                }
            }
            sleepMs(100)
        }
        return false
    }

    fun closePage(page: String): Bool {
        val out = this.lock.withLock({ this.dropPage(page) })
        return out
    }

    fun dropPage(page: String): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        this.conn.call({ callId -> closeTargetCmd(callId, binding.target) }, 10000)
        return this.pages.drop(page)
    }

    fun closeContext(ctx: String): Bool {
        val out = this.lock.withLock({ this.dropContext(ctx) })
        return out
    }

    fun close(): Void {
        this.conn.close()
    }

    fun dropContext(ctx: String): Bool {
        val cdpCtx = this.contexts.cdpId(ctx)
        if (cdpCtx == null) {
            return false
        }
        this.pages.dropByContext(ctx)
        this.conn.call({ callId -> disposeBrowserContextCmd(callId, cdpCtx) }, 10000)
        return this.contexts.drop(ctx)
    }

    fun subscribe(page: String, topic: String): Bool {
        val out = this.lock.withLock({ this.addSubscription(page, topic) })
        return out
    }

    fun addSubscription(page: String, topic: String): Bool {
        val binding = this.pages.binding(page)
        if (binding == null) {
            return false
        }
        if (topic == "request" || topic == "response") {
            if (this.conn.call({ callId -> sessionCmd(callId, binding.session, "Network.enable") }, 10000) == null) {
                return false
            }
        } else if (topic == "console") {
            if (this.conn.call({ callId -> sessionCmd(callId, binding.session, "Runtime.enable") }, 10000) == null) {
                return false
            }
        } else if (topic == "download") {
            // Download behavior is scoped per browser context: without the
            // context id only the default context allows downloads and
            // others get start-then-canceled.
            val cdpCtx = this.contexts.cdpId(binding.context)
            if (cdpCtx == null) {
                return false
            }
            if (this.armDownloads(cdpCtx) == false) {
                return false
            }
        } else {
            return false
        }
        this.subs.subscribe(page, topic)
        return true
    }

    fun unsubscribe(page: String, topic: String): Bool {
        val out = this.lock.withLock({ this.dropSubscription(page, topic) })
        return out
    }

    fun dropSubscription(page: String, topic: String): Bool {
        return this.subs.unsubscribe(page, topic)
    }

    fun drain(): List<String> {
        val out = this.lock.withLock({ this.drainNotifications() })
        return out
    }

    fun drainNotifications(): List<String> {
        var pumps = 0
        var quiet = false
        while (quiet == false && pumps < 10) {
            val f = this.conn.reader.readFrame(20)
            if (f == null) {
                quiet = true
            } else if (f.opcode == 1 || f.opcode == 2) {
                this.conn.events.add(f.payload)
            }
            pumps = pumps + 1
        }
        val out: MutableList<String> = MutableList<String>()
        var i = 0
        while (i < this.conn.events.size()) {
            val note = this.translateEvent(this.conn.events.get(i))
            if (note != null) {
                out.add(note)
            }
            i = i + 1
        }
        this.conn.events = MutableList<String>()
        return out.freeze()
    }

    fun translateEvent(raw: String): String? {
        val msg = parseJson(raw)
        val methodVal = msg.get("method")
        if (methodVal == null || methodVal!!.isString() == false) {
            return null
        }
        val method = methodVal!!.asString()
        if (method == "Browser.downloadWillBegin" || method == "Browser.downloadProgress") {
            return this.translateDownload(msg, method)
        }
        val session = cdpSessionOf(msg)
        if (session == "") {
            return null
        }
        val page = this.pages.pageForSession(session)
        if (page == null) {
            return null
        }
        if (method == "Network.requestWillBeSent") {
            if (this.subs.subscribed(page, "request") == false) {
                return null
            }
            return this.requestNote(page, msg)
        }
        if (method == "Network.responseReceived") {
            if (this.subs.subscribed(page, "response") == false) {
                return null
            }
            return this.responseNote(page, msg)
        }
        if (method == "Runtime.consoleAPICalled") {
            if (this.subs.subscribed(page, "console") == false) {
                return null
            }
            return this.consoleNote(page, msg)
        }
        return null
    }

    fun requestNote(page: String, msg: JsonValue): String? {
        val params = msg.get("params")
        if (params == null) {
            return null
        }
        val idVal = params!!.get("requestId")
        val reqVal = params!!.get("request")
        if (idVal == null || reqVal == null || idVal!!.isString() == false) {
            return null
        }
        val urlVal = reqVal!!.get("url")
        val methodVal = reqVal!!.get("method")
        if (urlVal == null || methodVal == null || urlVal!!.isString() == false || methodVal!!.isString() == false) {
            return null
        }
        val m = MutableMap<String, JsonValue>()
        m.put("page", jsonString(page))
        m.put("request", jsonString(idVal!!.asString()))
        m.put("url", jsonString(urlVal!!.asString()))
        m.put("method", jsonString(methodVal!!.asString()))
        return notifyFrame("page.request", jsonObject(m.freeze()).write())
    }

    fun responseNote(page: String, msg: JsonValue): String? {
        val params = msg.get("params")
        if (params == null) {
            return null
        }
        val idVal = params!!.get("requestId")
        val resVal = params!!.get("response")
        if (idVal == null || resVal == null || idVal!!.isString() == false) {
            return null
        }
        val urlVal = resVal!!.get("url")
        val statusVal = resVal!!.get("status")
        if (urlVal == null || statusVal == null || urlVal!!.isString() == false || statusVal!!.isNumber() == false) {
            return null
        }
        val m = MutableMap<String, JsonValue>()
        m.put("page", jsonString(page))
        m.put("request", jsonString(idVal!!.asString()))
        m.put("url", jsonString(urlVal!!.asString()))
        m.put("status", jsonNumber(statusVal!!.asNumber()))
        return notifyFrame("page.response", jsonObject(m.freeze()).write())
    }

    fun consoleNote(page: String, msg: JsonValue): String? {
        val params = msg.get("params")
        if (params == null) {
            return null
        }
        val typeVal = params!!.get("type")
        if (typeVal == null || typeVal!!.isString() == false) {
            return null
        }
        var text = typeVal!!.asString()
        val argsVal = params!!.get("args")
        if (argsVal != null && argsVal!!.isArray()) {
            val args = argsVal!!.asArray()
            if (args.size() > 0) {
                val first = args.get(0).get("value")
                if (first != null) {
                    text = first!!.write()
                }
            }
        }
        val m = MutableMap<String, JsonValue>()
        m.put("page", jsonString(page))
        m.put("kind", jsonString(typeVal!!.asString()))
        m.put("text", jsonString(text))
        return notifyFrame("page.console", jsonObject(m.freeze()).write())
    }

    fun armDownloads(cdpCtx: String): Bool {
        if (this.armedDownloads.contains(cdpCtx)) {
            return true
        }
        if (this.downloadDir == "" || cdpCtx == "") {
            return false
        }
        if (this.conn.call({ callId -> downloadBehaviorCmd(callId, this.downloadDir, cdpCtx) }, 10000) == null) {
            return false
        }
        this.armedDownloads.add(cdpCtx)
        return true
    }

    fun translateDownload(msg: JsonValue, method: String): String? {
        val params = msg.get("params")
        if (params == null) {
            return null
        }
        val guidVal = params!!.get("guid")
        if (guidVal == null || guidVal!!.isString() == false) {
            return null
        }
        val guid = guidVal!!.asString()
        if (method == "Browser.downloadWillBegin") {
            val frameVal = params!!.get("frameId")
            val nameVal = params!!.get("suggestedFilename")
            if (nameVal == null || nameVal!!.isString() == false) {
                return null
            }
            var page = ""
            if (frameVal != null && frameVal!!.isString()) {
                val found = this.pages.pageForFrame(frameVal!!.asString())
                if (found != null) {
                    page = found
                }
            }
            val fileName = nameVal!!.asString()
            this.downloads.put(guid, DownloadState(this.downloadDir + "/eiwa-dl-" + guid, page, fileName, guessMime(fileName), 0))
            return null
        }
        val stateVal = params!!.get("state")
        if (stateVal == null || stateVal!!.isString() == false || stateVal!!.asString() != "completed") {
            if (stateVal != null && stateVal!!.isString() && stateVal!!.asString() == "canceled") {
                this.downloads.remove(guid)
            }
            return null
        }
        val known = this.downloads.get(guid)
        if (known == null) {
            return null
        }
        val totalVal = params!!.get("totalBytes")
        var size = known.size
        if (totalVal != null && totalVal!!.isNumber()) {
            size = totalVal!!.asNumber().toInt()
        }
        var page = known.page
        if (page == "") {
            for (this.subs.topics) { entry ->
                if (entry.value.contains("download")) {
                    page = entry.key
                }
            }
        }
        if (page == "") {
            return null
        }
        // Chromium reports where it saved the file (filePath); the
        // guid-based name is only a fallback for fakes and old builds.
        var path = known.path
        val pathVal = params!!.get("filePath")
        if (pathVal != null && pathVal!!.isString() && pathVal!!.asString() != "") {
            path = pathVal!!.asString()
        }
        this.downloads.put(guid, DownloadState(path, page, known.fileName, known.mime, size))
        val m = MutableMap<String, JsonValue>()
        m.put("page", jsonString(page))
        m.put("download", jsonString(guid))
        m.put("fileName", jsonString(known.fileName))
        m.put("mime", jsonString(known.mime))
        m.put("size", jsonNumber(size.toDouble()))
        return notifyFrame("page.download", jsonObject(m.freeze()).write())
    }

    fun downloadBytes(guid: String): String? {
        val out = this.lock.withLock({ this.readDownload(guid, 0, 0) })
        return out
    }

    fun downloadChunk(guid: String, offset: Int, size: Int): String? {
        val out = this.lock.withLock({ this.readDownload(guid, offset, size) })
        return out
    }

    fun readDownload(guid: String, offset: Int, size: Int): String? {
        val known = this.downloads.get(guid)
        if (known == null) {
            return null
        }
        if (File.exists(known.path) == false) {
            return null
        }
        val data = File.read(known.path)
        var start = offset
        if (start < 0) {
            start = 0
        }
        var end = data.length
        if (size > 0 && start + size < end) {
            end = start + size
        }
        if (start >= end) {
            return null
        }
        return Encoding.base64Url(data.slice(start, end))
    }

    fun cookies(ctx: String): List<Cookie>? {
        val out = this.lock.withLock({ this.readCookies(ctx) })
        return out
    }

    fun readCookies(ctx: String): List<Cookie>? {
        val cdpCtx = this.contexts.cdpId(ctx)
        if (cdpCtx == null) {
            return null
        }
        val raw = this.conn.call({ callId -> storageCookiesCmd(callId, cdpCtx) }, 10000)
        if (raw == null) {
            return null
        }
        return parseStorageCookies(parseJson(raw))
    }

    fun addCookie(ctx: String, cookie: Cookie): Bool {
        val out = this.lock.withLock({ this.writeCookie(ctx, cookie) })
        return out
    }

    fun writeCookie(ctx: String, cookie: Cookie): Bool {
        val cdpCtx = this.contexts.cdpId(ctx)
        if (cdpCtx == null) {
            return false
        }
        return this.conn.call({ callId -> storageSetCmd(callId, cdpCtx, cookie) }, 10000) != null
    }

    fun clearCookies(ctx: String): Bool {
        val out = this.lock.withLock({ this.dropCookies(ctx) })
        return out
    }

    fun dropCookies(ctx: String): Bool {
        val cdpCtx = this.contexts.cdpId(ctx)
        if (cdpCtx == null) {
            return false
        }
        return this.conn.call({ callId -> storageClearCmd(callId, cdpCtx) }, 10000) != null
    }

    fun storageState(ctx: String): String? {
        val out = this.lock.withLock({ this.exportState(ctx) })
        return out
    }

    fun exportState(ctx: String): String? {
        val jar = this.readCookies(ctx)
        if (jar == null) {
            return null
        }
        val known = jar
        val items: MutableList<JsonValue> = MutableList<JsonValue>()
        var i = 0
        while (i < known.size()) {
            items.add(cookieValue(known.get(i)))
            i = i + 1
        }
        val none: MutableList<JsonValue> = MutableList<JsonValue>()
        val m = MutableMap<String, JsonValue>()
        m.put("cookies", jsonArray(items.freeze()))
        m.put("origins", jsonArray(none.freeze()))
        return jsonObject(m.freeze()).write()
    }
}

fun matchGlob(pattern: String, text: String): Bool {
    return matchGlobAt(pattern, 0, text, 0)
}

fun matchGlobAt(p: String, pi: Int, t: String, ti: Int): Bool {
    var i = pi
    var j = ti
    while (i < p.length) {
        val c = p.substring(i, i + 1)
        if (c == "*") {
            if (i + 1 < p.length && p.substring(i + 1, i + 2) == "*") {
                var ni = i + 2
                while (ni < p.length && p.substring(ni, ni + 1) == "*") {
                    ni = ni + 1
                }
                if (ni >= p.length) {
                    return true
                }
                var k = j
                while (k <= t.length) {
                    if (matchGlobAt(p, ni, t, k)) {
                        return true
                    }
                    k = k + 1
                }
                return false
            }
            var k = j
            while (true) {
                if (matchGlobAt(p, i + 1, t, k)) {
                    return true
                }
                if (k >= t.length || t.substring(k, k + 1) == "/") {
                    return false
                }
                k = k + 1
            }
        }
        if (j >= t.length) {
            return false
        }
        if (c == "?") {
            if (t.substring(j, j + 1) == "/") {
                return false
            }
        } else if (c != t.substring(j, j + 1)) {
            return false
        }
        i = i + 1
        j = j + 1
    }
    return j >= t.length
}
