// Deadline-bounded frame reading over a shared socket.
//
// Unlike one-shot `wsRecv`, a reader keeps leftover bytes across calls,
// so interleaved events are never lost, and every wait is bounded by a
// deadline (`Socket.read` alone blocks indefinitely).

import { Socket } from "std.net"
import { EventLoop } from "std.coroutines"
import { nowMillis } from "std.time"
import { WsFrame, parseHeader, applyMask } from ".browser.net.ws"

type FrameReader(val sock: Socket, var pending: String = "") {

    fun fill(ms: Int): Bool {
        if (EventLoop.waitReadable(this.sock.fd, ms) <= 0) {
            return false
        }
        val chunk = this.sock.read(4096)
        if (chunk == "") {
            return false
        }
        this.pending = this.pending + chunk
        return true
    }

    fun readFrame(ms: Int): WsFrame? {
        val end = nowMillis() + ms
        while (nowMillis() < end) {
            if (this.pending.length >= 2) {
                val h = parseHeader(this.pending)
                if (h != null) {
                    var need = h.headerLen + h.length
                    if (h.masked) {
                        need = need + 4
                    }
                    if (this.pending.length >= need) {
                        var off = h.headerLen
                        var mask = ""
                        if (h.masked) {
                            mask = this.pending.substring(off, off + 4)
                            off = off + 4
                        }
                        var payload = this.pending.substring(off, off + h.length)
                        this.pending = this.pending.substring(need, this.pending.length)
                        if (h.masked) {
                            payload = applyMask(payload, mask, 0)
                        }
                        return WsFrame(h.opcode, h.fin, payload)
                    }
                }
            }
            val left = end - nowMillis()
            if (left <= 0) {
                return null
            }
            if (left < 500) {
                this.fill(left)
            } else {
                this.fill(500)
            }
        }
        return null
    }
}
