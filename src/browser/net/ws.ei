// WebSocket client over std.net TCP (RFC 6455).
//
// Pure Eiwa: HTTP Upgrade handshake with accept verification (via the
// crypto lib), masked client frames, ping/pong, close. All IO suspends
// and MUST run inside `task {}`. Servers MUST NOT mask (§5.1); masked
// inbound frames are a protocol error.

import { NativeMemory } from "std.core"
import { Socket, SocketClient } from "std.net"
import { Crypto } from "crypto.crypto"

fun wsGuid(): String = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

fun wsAccept(key: String): String {
    return Crypto.sha1Base64("${key}${wsGuid()}")
}

fun xorByte(a: Int, b: Int): Int {
    var r = 0
    var m = 1
    var x = a
    var y = b
    var i = 0
    while (i < 8) {
        r = r + ((x % 2 + y % 2) % 2) * m
        m = m * 2
        x = x / 2
        y = y / 2
        i = i + 1
    }
    return r
}

fun randomMask(): String {
    val buf = Standard.gcMalloc(5)
    NativeMemory.randomBytes(buf, 4)
    NativeMemory.writeByte(buf, 4, 0)
    return String(buf, 4)
}

fun applyMask(payload: String, mask: String, offset: Int): String {
    val len = payload.length
    val buf = Standard.gcMalloc(len + 1)
    var i = 0
    while (i < len) {
        val m = NativeMemory.readByte(mask.ptr!!, (offset + i) % 4)
        val p = NativeMemory.readByte(payload.ptr!!, i)
        NativeMemory.writeByte(buf, i, xorByte(p, m))
        i = i + 1
    }
    NativeMemory.writeByte(buf, len, 0)
    return String(buf, len)
}

type WsHeader(val fin: Bool, val opcode: Int, val masked: Bool, val length: Int, val headerLen: Int)

fun parseHeader(head: String): WsHeader? {
    if (head.length < 2) {
        return null
    }
    val b0 = NativeMemory.readByte(head.ptr!!, 0)
    val b1 = NativeMemory.readByte(head.ptr!!, 1)
    val fin = b0 / 128 == 1
    val opcode = b0 % 16
    val masked = b1 / 128 == 1
    val marker = b1 % 128
    if (marker < 126) {
        return WsHeader(fin, opcode, masked, marker, 2)
    }
    if (marker == 126) {
        if (head.length < 4) {
            return null
        }
        val hi = NativeMemory.readByte(head.ptr!!, 2)
        val lo = NativeMemory.readByte(head.ptr!!, 3)
        return WsHeader(fin, opcode, masked, hi * 256 + lo, 4)
    }
    if (head.length < 10) {
        return null
    }
    var len = 0
    var k = 0
    while (k < 8) {
        len = len * 256 + NativeMemory.readByte(head.ptr!!, 2 + k)
        k = k + 1
    }
    return WsHeader(fin, opcode, masked, len, 10)
}

// Builds one frame. A null mask means unmasked (server side / tests).
fun buildFrame(opcode: Int, payload: String, mask: String?): String {
    val len = payload.length
    val masked = mask != null
    var headLen = 2
    if (len > 125 && len < 65536) {
        headLen = 4
    }
    if (len >= 65536) {
        headLen = 10
    }
    val body = if (masked) applyMask(payload, mask!!, 0) else payload
    val total = headLen + (if (masked) 4 else 0) + len
    val buf = Standard.gcMalloc(total + 1)
    NativeMemory.writeByte(buf, 0, 128 + opcode)
    var o = 1
    if (len < 126) {
        var b1 = len
        if (masked) {
            b1 = b1 + 128
        }
        NativeMemory.writeByte(buf, o, b1)
        o = o + 1
    } else if (len < 65536) {
        if (masked) {
            NativeMemory.writeByte(buf, o, 254)
        } else {
            NativeMemory.writeByte(buf, o, 126)
        }
        NativeMemory.writeByte(buf, o + 1, len / 256)
        NativeMemory.writeByte(buf, o + 2, len % 256)
        o = o + 3
    } else {
        if (masked) {
            NativeMemory.writeByte(buf, o, 255)
        } else {
            NativeMemory.writeByte(buf, o, 127)
        }
        var pow = 1
        var p = 0
        while (p < 7) {
            pow = pow * 256
            p = p + 1
        }
        var k = 0
        while (k < 8) {
            NativeMemory.writeByte(buf, o + 1 + k, (len / pow) % 256)
            pow = pow / 256
            k = k + 1
        }
        o = o + 9
    }
    if (masked) {
        var i = 0
        while (i < 4) {
            NativeMemory.writeByte(buf, o + i, NativeMemory.readByte(mask!!.ptr!!, i))
            i = i + 1
        }
        o = o + 4
    }
    var i = 0
    while (i < len) {
        NativeMemory.writeByte(buf, o + i, NativeMemory.readByte(body.ptr!!, i))
        i = i + 1
    }
    NativeMemory.writeByte(buf, total, 0)
    return String(buf, total)
}

fun readExact(sock: Socket, n: Int): String? {
    val buf = Standard.gcMalloc(n + 1)
    var got = 0
    while (got < n) {
        val chunk = sock.read(n - got)
        if (chunk == "") {
            return null
        }
        var take = chunk.length
        if (got + take > n) {
            take = n - got
        }
        var i = 0
        while (i < take) {
            NativeMemory.writeByte(buf, got + i, NativeMemory.readByte(chunk.ptr!!, i))
            i = i + 1
        }
        got = got + take
    }
    NativeMemory.writeByte(buf, n, 0)
    return String(buf, n)
}

fun writeAll(sock: Socket, data: String): Bool {
    var sent = 0
    while (sent < data.length) {
        val n = sock.write(data.substring(sent, data.length))
        if (n <= 0) {
            return false
        }
        sent = sent + n
    }
    return true
}

type WsFrame(val opcode: Int, val fin: Bool, val payload: String)

fun wsRecv(sock: Socket): WsFrame? {
    val first = readExact(sock, 2)
    if (first == null) {
        return null
    }
    val marker = NativeMemory.readByte(first.ptr!!, 1) % 128
    var extra = 0
    if (marker == 126) {
        extra = 2
    }
    if (marker == 127) {
        extra = 8
    }
    var head = first
    if (extra > 0) {
        val more = readExact(sock, extra)
        if (more == null) {
            return null
        }
        head = first + more
    }
    val h = parseHeader(head)
    if (h == null) {
        return null
    }
    var mask = ""
    if (h.masked) {
        val key = readExact(sock, 4)
        if (key == null) {
            return null
        }
        mask = key
    }
    val raw = readExact(sock, h.length)
    if (raw == null) {
        return null
    }
    if (h.masked) {
        return WsFrame(h.opcode, h.fin, applyMask(raw, mask, 0))
    }
    return WsFrame(h.opcode, h.fin, raw)
}

// Validates a complete HTTP response header block for our key.
fun validHandshake(res: String, key: String): Bool {
    var ok = false
    var accept = ""
    val lines = res.split("\r\n")
    for (lines) { line ->
        if (line.indexOf("HTTP/1.1 101") == 0) {
            ok = true
        }
        if (line.indexOf("Sec-WebSocket-Accept:") == 0) {
            val colon = line.indexOf(":")
            accept = line.substring(colon + 1, line.length).trim()
        }
    }
    if (ok == false) {
        return false
    }
    return accept == wsAccept(key)
}

fun readHandshake(sock: Socket, key: String): Bool {
    // Byte-precise: bulk reads would swallow frame bytes pipelined
    // right behind the 101 response (same-segment coalescing).
    var res = ""
    while (res.indexOf("\r\n\r\n") < 0) {
        if (res.length > 8192) {
            return false
        }
        val chunk = sock.read(1)
        if (chunk == "") {
            return false
        }
        res = res + chunk
    }
    return validHandshake(res, key)
}

type WsClient(val socket: Socket, var closed: Bool = false) {

    fun sendText(payload: String): Bool {
        if (this.closed) {
            return false
        }
        return writeAll(this.socket, buildFrame(1, payload, randomMask()))
    }

    fun ping(payload: String): Bool {
        if (this.closed) {
            return false
        }
        return writeAll(this.socket, buildFrame(9, payload, randomMask()))
    }

    fun recv(): String? {
        while (this.closed == false) {
            val f = wsRecv(this.socket)
            if (f == null) {
                this.closed = true
                return null
            }
            if (f.opcode == 8) {
                this.closed = true
                return null
            }
            if (f.opcode == 9) {
                writeAll(this.socket, buildFrame(10, f.payload, randomMask()))
            } else if (f.opcode == 1 || f.opcode == 2) {
                if (f.fin) {
                    return f.payload
                }
                this.closed = true
                return null
            }
        }
        return null
    }

    fun close(): Void {
        if (this.closed == false) {
            writeAll(this.socket, buildFrame(8, "", randomMask()))
        }
        this.closed = true
        this.socket.close()
    }
}

fun wsConnect(host: String, port: Int, path: String): WsClient? {
    val sock = SocketClient.connect(host, port)
    if (sock == null) {
        return null
    }
    val key = Crypto.randomBase64(16)
    var req = "GET $path HTTP/1.1\r\n"
    req = req + "Host: $host:$port\r\n"
    req = req + "Upgrade: websocket\r\n"
    req = req + "Connection: Upgrade\r\n"
    req = req + "Sec-WebSocket-Key: $key\r\n"
    req = req + "Sec-WebSocket-Version: 13\r\n"
    req = req + "\r\n"
    if (writeAll(sock, req) == false) {
        sock.close()
        return null
    }
    if (readHandshake(sock, key) == false) {
        sock.close()
        return null
    }
    return WsClient(sock)
}
