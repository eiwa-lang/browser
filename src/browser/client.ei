// WorkerClient: one persistent WebSocket per worker URL (§§5.2, 30.2).
//
// Owns the socket, the frame reader, id counters and the `initialize`
// handshake. Handles (Browser, contexts, pages) delegate sends here;
// replies are awaited by id, interleaved notifications stash into
// `events` for `poll()`.

import { MutableList } from "std.collections"
import { parseJson } from "std.json"
import { nowMillis } from "std.time"
import { throwForReply } from ".browser.protocol.errors"
import { WsClient, wsConnect } from ".browser.net.ws"
import { FrameReader } from ".browser.net.reader"
import { requestFrame, initializeRequest } from ".browser.protocol.envelope"
import { parseWsUrl } from ".browser.chromium.cdp"

type WorkerClient(val ws: WsClient, val reader: FrameReader, val protoVersion: String, var nextId: Int = 2, var events: MutableList<String> = MutableList<String>()) {

    fun version(): String {
        return this.protoVersion
    }

    fun awaitReply(id: Int, timeoutMs: Int = 30000): String? {
        val end = nowMillis() + timeoutMs
        while (nowMillis() < end) {
            val left = end - nowMillis()
            if (left <= 0) {
                return null
            }
            val slice = if (left < 2000) { left } else { 2000 }
            val f = this.reader.readFrame(slice)
            if (f == null) {
            } else if (f.opcode == 8) {
                this.ws.close()
                return null
            } else if (f.opcode == 1 || f.opcode == 2) {
                val msg = parseJson(f.payload)
                val got = msg.get("id")
                if (got != null && got!!.isNumber() && got!!.asNumber().toInt() == id) {
                    val res = msg.get("result")
                    if (res == null) {
                        throwForReply(msg)
                        return null
                    }
                    return res!!.write()
                }
                if (got == null) {
                    this.events.add(f.payload)
                }
            }
        }
        return null
    }

    fun drainEvents(): List<String> {
        val out = this.events
        this.events = MutableList<String>()
        return out.freeze()
    }

    fun poll(timeoutMs: Int): List<String> {
        val out: MutableList<String> = MutableList<String>()
        var left = timeoutMs
        while (left > 0) {
            val slice = if (left < 200) { left } else { 200 }
            val f = this.reader.readFrame(slice)
            if (f == null) {
                left = 0
            } else if (f.opcode == 8) {
                this.ws.close()
                left = 0
            } else if (f.opcode == 1 || f.opcode == 2) {
                val msg = parseJson(f.payload)
                if (msg.get("id") == null) {
                    out.add(f.payload)
                }
                left = left - 200
            } else {
                left = left - 200
            }
        }
        return out.freeze()
    }

    fun call(method: String, params: String, timeoutMs: Int = 30000): String? {
        val id = this.nextId
        this.nextId = this.nextId + 1
        if (this.ws.sendText(requestFrame(id, method, params)) == false) {
            return null
        }
        return this.awaitReply(id, timeoutMs)
    }

    fun close(): Void {
        this.ws.close()
    }
}

fun workerPath(url: String): String {
    var rest = url
    if (url.indexOf("ws://") == 0) {
        rest = url.substring(5, url.length)
    } else if (url.indexOf("wss://") == 0) {
        rest = url.substring(6, url.length)
    }
    if (rest.indexOf("/") < 0) {
        return url + "/"
    }
    return url
}

fun workerConnect(url: String): WorkerClient? {
    val ep = parseWsUrl(workerPath(url), 80)
    if (ep == null) {
        return null
    }
    val ws = wsConnect(ep.host, ep.port, ep.path)
    if (ws == null) {
        return null
    }
    val reader = FrameReader(ws.socket, "")
    if (ws.sendText(initializeRequest("1.0")) == false) {
        ws.close()
        return null
    }
    var tries = 0
    while (tries < 10) {
        val f = reader.readFrame(2000)
        if (f == null) {
            ws.close()
            return null
        }
        if (f.opcode == 1 || f.opcode == 2) {
            val msg = parseJson(f.payload)
            val got = msg.get("id")
            if (got != null && got!!.isNumber() && got!!.asNumber().toInt() == 1) {
                val res = msg.get("result")
                if (res == null) {
                    ws.close()
                    return null
                }
                val ver = res!!.get("version")
                if (ver == null || ver!!.isString() == false) {
                    ws.close()
                    return null
                }
                return WorkerClient(ws, reader, ver!!.asString())
            }
        }
        tries = tries + 1
    }
    ws.close()
    return null
}
