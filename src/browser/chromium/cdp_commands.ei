// CDP command builders and payload parsing (flat mode).
//
// Frames travel over the browser WS client; ids are per-connection,
// routing per `sessionId`. Shapes follow the DevTools protocol.

import { MutableList, MutableMap } from "std.collections"
import { JsonValue, jsonObject, jsonString, jsonBool, jsonNumber, jsonArray } from "std.json"
import { Cookie, parseCookie } from ".browser.storage.cookies"

fun cdpRequest(id: Int, method: String, params: String): String {
    return "{\"id\": $id, \"method\": \"$method\", \"params\": $params}"
}

fun cdpRequestSession(id: Int, session: String, method: String, params: String): String {
    return "{\"id\": $id, \"sessionId\": \"$session\", \"method\": \"$method\", \"params\": $params}"
}

fun createTargetCmd(id: Int, url: String): String? {
    if (url == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("url", jsonString(url))
    return cdpRequest(id, "Target.createTarget", jsonObject(params.freeze()).write())
}

fun attachCmd(id: Int, target: String): String? {
    if (target == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("targetId", jsonString(target))
    params.put("flatten", jsonBool(true))
    return cdpRequest(id, "Target.attachToTarget", jsonObject(params.freeze()).write())
}

fun navigateCmd(id: Int, session: String, url: String): String? {
    if (session == "" || url == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("url", jsonString(url))
    return cdpRequestSession(id, session, "Page.navigate", jsonObject(params.freeze()).write())
}

fun evaluateCmd(id: Int, session: String, script: String): String? {
    if (session == "" || script == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("expression", jsonString(script))
    params.put("returnByValue", jsonBool(true))
    return cdpRequestSession(id, session, "Runtime.evaluate", jsonObject(params.freeze()).write())
}

fun closeTargetCmd(id: Int, target: String): String? {
    if (target == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("targetId", jsonString(target))
    return cdpRequest(id, "Target.closeTarget", jsonObject(params.freeze()).write())
}

fun createBrowserContextCmd(id: Int): String {
    return cdpRequest(id, "Target.createBrowserContext", "{}")
}

fun createTargetCtxCmd(id: Int, url: String, ctx: String): String? {
    if (url == "" || ctx == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("url", jsonString(url))
    params.put("browserContextId", jsonString(ctx))
    return cdpRequest(id, "Target.createTarget", jsonObject(params.freeze()).write())
}

fun disposeBrowserContextCmd(id: Int, ctx: String): String? {
    if (ctx == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("browserContextId", jsonString(ctx))
    return cdpRequest(id, "Target.disposeBrowserContext", jsonObject(params.freeze()).write())
}

fun sessionCmd(id: Int, session: String, method: String): String? {
    if (session == "" || method == "") {
        return null
    }
    return cdpRequestSession(id, session, method, "{}")
}

fun downloadBehaviorCmd(id: Int, dir: String, contextId: String = ""): String? {
    if (dir == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("behavior", jsonString("allow"))
    if (contextId != "") {
        params.put("browserContextId", jsonString(contextId))
    }
    params.put("downloadPath", jsonString(dir))
    params.put("eventsEnabled", jsonBool(true))
    return cdpRequest(id, "Browser.setDownloadBehavior", jsonObject(params.freeze()).write())
}

fun storageCookiesCmd(id: Int, ctx: String): String? {
    if (ctx == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("browserContextId", jsonString(ctx))
    return cdpRequest(id, "Storage.getCookies", jsonObject(params.freeze()).write())
}

fun storageSetCmd(id: Int, ctx: String, cookie: Cookie): String? {
    if (ctx == "" || cookie.name == "" || cookie.domain == "") {
        return null
    }
    val path = if (cookie.path == "") { "/" } else { cookie.path }
    val entry = MutableMap<String, JsonValue>()
    entry.put("name", jsonString(cookie.name))
    entry.put("value", jsonString(cookie.value))
    entry.put("url", jsonString("https://" + cookie.domain + path))
    entry.put("domain", jsonString(cookie.domain))
    entry.put("path", jsonString(path))
    entry.put("secure", jsonBool(cookie.secure))
    entry.put("httpOnly", jsonBool(cookie.httpOnly))
    entry.put("sameSite", jsonString(cookie.sameSite))
    val items: MutableList<JsonValue> = MutableList<JsonValue>()
    items.add(jsonObject(entry.freeze()))
    val params = MutableMap<String, JsonValue>()
    params.put("cookies", jsonArray(items.freeze()))
    params.put("browserContextId", jsonString(ctx))
    return cdpRequest(id, "Storage.setCookies", jsonObject(params.freeze()).write())
}

fun storageClearCmd(id: Int, ctx: String): String? {
    if (ctx == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("browserContextId", jsonString(ctx))
    return cdpRequest(id, "Storage.clearCookies", jsonObject(params.freeze()).write())
}

fun parseStorageCookies(reply: JsonValue): List<Cookie> {
    val out: MutableList<Cookie> = MutableList<Cookie>()
    val result = reply.get("result")
    if (result == null) {
        return out.freeze()
    }
    val jar = result!!.get("cookies")
    if (jar == null || jar!!.isArray() == false) {
        return out.freeze()
    }
    val entries = jar!!.asArray()
    var i = 0
    while (i < entries.size()) {
        val c = parseCookie(entries.get(i))
        if (c != null) {
            out.add(c)
        }
        i = i + 1
    }
    return out.freeze()
}

fun locatorFindChain(): String {
    return "let el = null; if (s.strategy === \"css\") { el = document.querySelector(s.selector); } else if (s.strategy === \"xpath\") { el = document.evaluate(s.selector, document, null, 9, null).singleNodeValue; } else if (s.strategy === \"text\") { const v = s.selector; const q = v.indexOf('\"') < 0 ? '\"' + v + '\"' : (v.indexOf(\"'\") < 0 ? \"'\" + v + \"'\" : \"concat('\" + v.split(\"'\").join(\"', \\\"'\\\", '\") + \"')\"); el = document.evaluate(\"//*[contains(normalize-space(), \" + q + \")]\", document, null, 9, null).singleNodeValue; } else if (s.strategy === \"role\") { el = document.querySelector('[role=\"' + s.selector.split('\"').join('\\\"') + '\"]'); }"
}

fun locatorArgs(strategy: String, selector: String): MutableMap<String, JsonValue> {
    val args = MutableMap<String, JsonValue>()
    args.put("strategy", jsonString(strategy))
    args.put("selector", jsonString(selector))
    return args
}

fun locatorTextScript(strategy: String, selector: String): String? {
    if (strategy == "" || selector == "") {
        return null
    }
    return "((s) => {" + locatorFindChain() + " return el ? el.innerText : null;})(" + jsonObject(locatorArgs(strategy, selector).freeze()).write() + ")"
}

fun locatorClickScript(strategy: String, selector: String): String? {
    if (strategy == "" || selector == "") {
        return null
    }
    return "((s) => {" + locatorFindChain() + " if (!el) return null; el.click(); return \"ok\";})(" + jsonObject(locatorArgs(strategy, selector).freeze()).write() + ")"
}

fun locatorFillScript(strategy: String, selector: String, value: String): String? {
    if (strategy == "" || selector == "") {
        return null
    }
    val args = locatorArgs(strategy, selector)
    args.put("value", jsonString(value))
    return "((s) => {" + locatorFindChain() + " if (!el) return null; el.focus(); el.value = s.value; el.dispatchEvent(new Event(\"input\", {bubbles: true})); el.dispatchEvent(new Event(\"change\", {bubbles: true})); return \"ok\";})(" + jsonObject(args.freeze()).write() + ")"
}

fun locatorTypeScript(strategy: String, selector: String, value: String): String? {
    if (strategy == "" || selector == "") {
        return null
    }
    val args = locatorArgs(strategy, selector)
    args.put("value", jsonString(value))
    return "((s) => {" + locatorFindChain() + " if (!el) return null; el.focus(); el.value = (el.value || \"\") + s.value; el.dispatchEvent(new Event(\"input\", {bubbles: true})); return \"ok\";})(" + jsonObject(args.freeze()).write() + ")"
}

fun locatorAttrScript(strategy: String, selector: String, name: String): String? {
    if (strategy == "" || selector == "" || name == "") {
        return null
    }
    val args = locatorArgs(strategy, selector)
    args.put("name", jsonString(name))
    return "((s) => {" + locatorFindChain() + " if (!el) return null; return el.getAttribute(s.name);})(" + jsonObject(args.freeze()).write() + ")"
}

fun locatorWaitScript(strategy: String, selector: String): String? {
    if (strategy == "" || selector == "") {
        return null
    }
    return "((s) => {" + locatorFindChain() + " if (!el) return null; const r = el.getBoundingClientRect(); return (r.width > 0 && r.height > 0) ? \"found\" : null;})(" + jsonObject(locatorArgs(strategy, selector).freeze()).write() + ")"
}

fun locatorFocusScript(strategy: String, selector: String): String? {
    if (strategy == "" || selector == "") {
        return null
    }
    return "((s) => {" + locatorFindChain() + " if (!el) return null; el.focus(); return \"ok\";})(" + jsonObject(locatorArgs(strategy, selector).freeze()).write() + ")"
}

fun inputInsertCmd(id: Int, session: String, text: String): String? {
    if (session == "" || text == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("text", jsonString(text))
    return cdpRequestSession(id, session, "Input.insertText", jsonObject(params.freeze()).write())
}

fun inputKeyCmd(id: Int, session: String, etype: String, key: String, code: String, vk: Int): String? {
    if (session == "" || etype == "" || key == "" || code == "" || vk <= 0) {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("type", jsonString(etype))
    params.put("key", jsonString(key))
    params.put("code", jsonString(code))
    params.put("windowsVirtualKeyCode", jsonNumber(vk.toDouble()))
    return cdpRequestSession(id, session, "Input.dispatchKeyEvent", jsonObject(params.freeze()).write())
}

fun vkFor(key: String): Int {
    if (key == "Enter") {
        return 13
    }
    if (key == "Tab") {
        return 9
    }
    if (key == "Escape") {
        return 27
    }
    if (key == "Backspace") {
        return 8
    }
    if (key == "Delete") {
        return 46
    }
    if (key == "ArrowLeft") {
        return 37
    }
    if (key == "ArrowUp") {
        return 38
    }
    if (key == "ArrowRight") {
        return 39
    }
    if (key == "ArrowDown") {
        return 40
    }
    if (key == "Home") {
        return 36
    }
    if (key == "End") {
        return 35
    }
    if (key == "PageUp") {
        return 33
    }
    if (key == "PageDown") {
        return 34
    }
    return 0
}

fun historyEntryCmd(id: Int, session: String, entryId: Int): String? {
    if (session == "" || entryId <= 0) {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("entryId", jsonNumber(entryId.toDouble()))
    return cdpRequestSession(id, session, "Page.navigateToHistoryEntry", jsonObject(params.freeze()).write())
}

fun parseHistoryEntry(reply: JsonValue, delta: Int): Int? {
    val result = reply.get("result")
    if (result == null) {
        return null
    }
    val idxVal = result!!.get("currentIndex")
    val entriesVal = result!!.get("entries")
    if (idxVal == null || entriesVal == null) {
        return null
    }
    if (idxVal!!.isNumber() == false || entriesVal!!.isArray() == false) {
        return null
    }
    val want = idxVal!!.asNumber().toInt() + delta
    val entries = entriesVal!!.asArray()
    if (want < 0 || want >= entries.size()) {
        return null
    }
    val idVal = entries.get(want).get("id")
    if (idVal == null || idVal!!.isNumber() == false) {
        return null
    }
    return idVal!!.asNumber().toInt()
}

type CdpSession(val target: String, val session: String)

fun parseAttached(result: JsonValue): CdpSession? {
    val res = result.get("result")
    if (res == null) {
        return null
    }
    val session = res!!.get("sessionId")
    if (session == null || session!!.isString() == false) {
        return null
    }
    return CdpSession("", session!!.asString())
}

fun parseTargetCreated(result: JsonValue): String? {
    val res = result.get("result")
    if (res == null) {
        return null
    }
    val target = res!!.get("targetId")
    if (target == null || target!!.isString() == false) {
        return null
    }
    return target!!.asString()
}

fun parseBrowserContextCreated(result: JsonValue): String? {
    val res = result.get("result")
    if (res == null) {
        return null
    }
    val ctx = res!!.get("browserContextId")
    if (ctx == null || ctx!!.isString() == false) {
        return null
    }
    return ctx!!.asString()
}

fun parseNavigateFrame(result: JsonValue): String? {
    val res = result.get("result")
    if (res == null) {
        return null
    }
    val frame = res!!.get("frameId")
    if (frame == null || frame!!.isString() == false) {
        return null
    }
    return frame!!.asString()
}

fun evaluateValue(result: JsonValue): JsonValue? {
    val res = result.get("result")
    if (res == null) {
        return null
    }
    if (res!!.get("exceptionDetails") != null) {
        return null
    }
    val remote = res!!.get("result")
    if (remote == null) {
        return null
    }
    return remote!!.get("value")
}

fun cdpEventMethod(raw: JsonValue): String {
    val method = raw.get("method")
    if (method == null || method!!.isString() == false) {
        return ""
    }
    return method!!.asString()
}

fun cdpSessionOf(raw: JsonValue): String {
    val session = raw.get("sessionId")
    if (session == null || session!!.isString() == false) {
        return ""
    }
    return session!!.asString()
}
