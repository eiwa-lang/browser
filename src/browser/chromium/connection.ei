// Driver for a live DevTools connection (§§5.4, 5.5).
//
// Owns the WS client, hands out ids and matches responses by id,
// skipping interleaved events (same shape as the CDP protocol itself).

import { MutableList } from "std.collections"
import { parseJson } from "std.json"
import { nowMillis } from "std.time"
import { WsClient, wsConnect } from ".browser.net.ws"
import { FrameReader } from ".browser.net.reader"
import { httpGet } from ".browser.net.http"
import { debuggerUrl, parseWsUrl } from ".browser.chromium.cdp"

type CdpConn(val ws: WsClient, val reader: FrameReader, var events: MutableList<String> = MutableList<String>(), var nextId: Int = 1) {

    fun close(): Void {
        this.ws.close()
    }

    fun call(build: (Int) -> String?, timeoutMs: Int): String? {
        val id = this.nextId
        this.nextId = this.nextId + 1
        val frame = build(id)
        if (frame == null) {
            return null
        }
        if (this.ws.sendText(frame) == false) {
            return null
        }
        val end = nowMillis() + timeoutMs
        while (nowMillis() < end) {
            val left = end - nowMillis()
            if (left <= 0) {
                return null
            }
            val f = if (left < 2000) this.reader.readFrame(left) else this.reader.readFrame(2000)
            if (f != null && (f.opcode == 1 || f.opcode == 2)) {
                val msg = parseJson(f.payload)
                val mid = msg.get("id")
                if (mid != null && mid!!.isNumber() && mid!!.asNumber().toInt() == id) {
                    return f.payload
                }
                this.events.add(f.payload)
            }
        }
        return null
    }
}

fun awaitEvent(conn: CdpConn, want: (String) -> Bool, timeoutMs: Int): Bool {
    var i = 0
    while (i < conn.events.size()) {
        if (want(conn.events.get(i))) {
            conn.events.remove(i)
            return true
        }
        i = i + 1
    }
    val end = nowMillis() + timeoutMs
    while (nowMillis() < end) {
        val left = end - nowMillis()
        if (left <= 0) {
            return false
        }
        val f = if (left < 2000) conn.reader.readFrame(left) else conn.reader.readFrame(2000)
        if (f != null && (f.opcode == 1 || f.opcode == 2)) {
            if (want(f.payload)) {
                return true
            }
            conn.events.add(f.payload)
        }
    }
    return false
}

fun cdpConn(ws: WsClient): CdpConn {
    return CdpConn(ws, FrameReader(ws.socket, ""), MutableList<String>(), 1)
}

fun attachDevtools(host: String, port: Int): CdpConn? {
    val res = httpGet(host, port, "/json/version")
    if (res == null || res.status != 200) {
        return null
    }
    val debug = debuggerUrl(res.body)
    if (debug == null) {
        return null
    }
    val ep = parseWsUrl(debug, port)
    if (ep == null) {
        return null
    }
    val ws = wsConnect(ep.host, ep.port, ep.path)
    if (ws == null) {
        return null
    }
    return cdpConn(ws)
}
