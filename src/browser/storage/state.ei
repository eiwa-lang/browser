// Storage state (§14) and downloads (§15, rule A).
//
// State travels as a value; downloads arrive as handles plus
// `download.bytes` (small, inline) or `artifact.read` chunks (large).
// Bytes travel base64url; the app saves.

import { MutableMap } from "std.collections"
import { JsonValue, jsonObject, jsonString, jsonNumber, parseJson } from "std.json"
import { requestFrame } from ".browser.protocol.envelope"
import { Encoding } from "crypto.encoding"
import { Browser } from ".browser.browser"

fun storageStateCmd(id: Int, context: String): String? {
    if (context == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("context", jsonString(context))
    return requestFrame(id, "context.storageState", jsonObject(params.freeze()).write())
}

type Download(
    val browser: Browser,
    val id: String,
    val context: String,
    val page: String,
    val fileName: String,
    val mime: String,
    val size: Int
) {

    fun bytes(): String? {
        val res = this.browser.callDownload(this.context, "download.bytes", downloadParams(this.id))
        if (res == null) {
            return null
        }
        return decodeBytes(res)
    }

    fun read(offset: Int, size: Int): String? {
        val res = this.browser.callDownload(this.context, "artifact.read", artifactParams(this.id, offset, size))
        if (res == null) {
            return null
        }
        return decodeBytes(res)
    }
}

fun downloadParams(download: String): String {
    val m = MutableMap<String, JsonValue>()
    m.put("download", jsonString(download))
    return jsonObject(m.freeze()).write()
}

fun artifactParams(artifact: String, offset: Int, size: Int): String {
    val m = MutableMap<String, JsonValue>()
    m.put("artifact", jsonString(artifact))
    m.put("offset", jsonNumber(offset.toDouble()))
    m.put("size", jsonNumber(size.toDouble()))
    return jsonObject(m.freeze()).write()
}

fun decodeBytes(res: String): String? {
    val b = parseJson(res).get("bytes")
    if (b == null || b!!.isString() == false) {
        return null
    }
    return Encoding.base64UrlDecode(b!!.asString())
}

fun parseDownload(browser: Browser, ctx: String, page: String, params: JsonValue): Download? {
    val id = params.get("download")
    val name = params.get("fileName")
    val mime = params.get("mime")
    val size = params.get("size")
    if (id == null || name == null || mime == null || size == null) {
        return null
    }
    if (id!!.isString() == false || name!!.isString() == false) {
        return null
    }
    if (mime!!.isString() == false || size!!.isNumber() == false) {
        return null
    }
    return Download(browser, id!!.asString(), ctx, page, name!!.asString(), mime!!.asString(), size!!.asNumber().toInt())
}

fun downloadBytesCmd(id: Int, download: String): String? {
    if (download == "") {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("download", jsonString(download))
    return requestFrame(id, "download.bytes", jsonObject(params.freeze()).write())
}

fun artifactReadCmd(id: Int, artifact: String, offset: Int, size: Int): String? {
    if (artifact == "" || offset < 0 || size <= 0) {
        return null
    }
    val params = MutableMap<String, JsonValue>()
    params.put("artifact", jsonString(artifact))
    params.put("offset", jsonNumber(offset.toDouble()))
    params.put("size", jsonNumber(size.toDouble()))
    return requestFrame(id, "artifact.read", jsonObject(params.freeze()).write())
}
